---
import { partners, associations, supporters } from '../utils/partners';

// Full tiles for the named partners — logo, role and name. Logo-only tiles,
// so anything still waiting on its logo file sits this out.
const tiles = partners.filter((p) => p.logo);

// Associations and supporters are a longer, lower-tier list, so each group
// renders as its own small logo strip rather than repeating the same full
// tile six more times — same reasoning and pattern as the Hero's
// featured-speakers band.
// ACAM's source file has a lot of transparent padding baked in (same issue
// fixed for the Hero band), so at this strip's compact height it renders
// far smaller than its neighbours — swap in the same tightly-cropped mark
// used there, for this strip only; /partners and the homepage logo cloud
// keep the original square file, sized differently, where the padding isn't
// a problem.
const miniLogo = (p: (typeof associations)[number]) =>
  p.name.startsWith('ACAM') ? '/images/logos/ACAM-mark.png' : p.logo;

const miniGroups = [
  { label: 'Supporting associations', items: associations.filter((p) => p.logo) },
  { label: 'Supporters', items: supporters.filter((p) => p.logo) },
].filter((g) => g.items.length > 0);
---

<section id="partners" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="rv">Our partners.</h2>
      <span class="sec-num">— Partners</span>
    </div>
    <div class="partners-strip rv">
      {
        tiles.map((p) => (
          <a href="/partners" class="partner-tile" style={`--ac:${p.accent}`}>
            <div class:list={['partner-tile-logo', p.logoDark && 'is-dark']}>
              <img src={p.logo} alt={`${p.name} logo`} loading="lazy" />
            </div>
            <div class="partner-tile-body">
              <span class="partner-tile-role">{p.role}</span>
              <span class="partner-tile-name">{p.name}</span>
            </div>
          </a>
        ))
      }
    </div>
    {
      miniGroups.map((g) => (
        <div class="partners-mini rv">
          <span class="partners-mini-label mono">{g.label}</span>
          <div class="partners-mini-logos">
            {
              g.items.map((p) => (
                <a href="/partners" class:list={['partners-mini-logo', p.logoDark && 'is-dark']} title={p.name}>
                  <img src={miniLogo(p)} alt={`${p.name} logo`} loading="lazy" />
                </a>
              ))
            }
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .partners-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .partner-tile {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 16px;
    padding: 24px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .partner-tile:hover {
    border-color: var(--ac);
    transform: translateY(-2px);
  }

  .partner-tile::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--ac);
  }

  .partner-tile-logo {
    width: 84px;
    height: 84px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid rgba(250, 247, 241, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  /* For logos that are light/white artwork and would disappear on white. */
  .partner-tile-logo.is-dark {
    background: var(--panel-2);
    border-color: var(--line-2);
  }

  .partner-tile-logo img {
    width: 76%;
    height: 76%;
    object-fit: contain;
  }

  .partner-tile-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .partner-tile-role {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ac);
  }

  .partner-tile-name {
    font-family: var(--disp);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  @media (max-width: 700px) {
    .partners-strip {
      grid-template-columns: 1fr;
    }
  }

  .partners-mini {
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .partners-mini-label {
    display: block;
    color: var(--ink-2);
    margin-bottom: 16px;
  }

  .partners-mini-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 14px;
  }

  .partners-mini-logo {
    flex: 1 1 0;
    min-width: 140px;
    background: #fff;
    border-radius: 10px;
    height: 76px;
    padding: 12px 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .partners-mini-logo:hover {
    transform: translateY(-2px);
  }

  .partners-mini-logo.is-dark {
    background: var(--panel-2);
    border: 1px solid var(--line-2);
  }

  .partners-mini-logo img {
    height: 100%;
    width: 100%;
    max-width: 100%;
    object-fit: contain;
  }

  @media (max-width: 700px) {
    .partners-mini-logo {
      height: 56px;
      min-width: 110px;
      padding: 10px 16px;
    }
  }
</style>
