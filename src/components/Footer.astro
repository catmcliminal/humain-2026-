---
import { TICKET_URL, TICKET_IS_EXTERNAL } from '../config';

const ticketTarget = TICKET_IS_EXTERNAL ? '_blank' : undefined;
const ticketRel = TICKET_IS_EXTERNAL ? 'noopener noreferrer' : undefined;
---

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div>
        <div class="brand">
          <b style="font-family:var(--disp);font-weight:800;font-size:30px"
            >hum<i style="font-style:normal;color:var(--pink)">AI</i>n</b
          >
        </div>
        <p class="foot-tag">
          An AI media platform, conference and community for the people exploring what stays human as the machines get
          good.
        </p>
      </div>
      <div class="foot-col">
        <h5>Event</h5><a href={TICKET_URL} target={ticketTarget} rel={ticketRel}>Tickets</a><a href="#">Programme</a
        ><a href="/voices">Speakers</a><a href="#">Sponsor</a>
      </div>
      <div class="foot-col">
        <h5>Media</h5><a href="/news">Articles</a><a href="#">Podcast</a><a href="#">Newsletter</a><a href="#"
          >Field notes</a
        >
      </div>
      <div class="foot-col">
        <h5>Community</h5><a href="#">Join</a><a href="#">Discord</a><a href="#">Members</a><a href="#">Contact</a>
      </div>
    </div>
    <div class="foot-bot">
      <span>© 2026 humAIn. Built in public.</span>
      <span class="mono">What remains irreducibly human?</span>
    </div>
  </div>
</footer>
