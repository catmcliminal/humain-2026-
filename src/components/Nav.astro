---
import { TICKET_URL, TICKET_IS_EXTERNAL } from '../config';

const ticketTarget = TICKET_IS_EXTERNAL ? '_blank' : undefined;
const ticketRel = TICKET_IS_EXTERNAL ? 'noopener noreferrer' : undefined;
---

<nav>
  <div class="wrap nav-in">
    <a href="/" class="brand">
      <img src="/images/humAIn-transparent-logo.png" alt="humAIn" class="brand-logo" />
    </a>
    <div class="nav-links">
      <a href="/#conference">Conference</a>
      <a href="/#themes">Themes</a>
      <a href="/#articles">Media</a>
      <a href="/#voices">Voices</a>
      <a href="/#gallery">Gallery</a>
      <a href="/#community">Community</a>
      <a href={TICKET_URL} class="btn" target={ticketTarget} rel={ticketRel}><span class="dot"></span>Get tickets</a>
    </div>
  </div>
</nav>
