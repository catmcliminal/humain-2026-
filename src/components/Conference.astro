---
import { TICKET_URL, TICKET_IS_EXTERNAL } from '../config';

const ticketTarget = TICKET_IS_EXTERNAL ? '_blank' : undefined;
const ticketRel = TICKET_IS_EXTERNAL ? 'noopener noreferrer' : undefined;
---

<section id="conference">
  <div class="wrap">
    <div class="conf">
      <div class="conf-in">
        <div class="conf-left">
          <div class="kik">▶ The flagship event</div>
          <h2>humAIn<br />2026</h2>
          <div class="conf-meta">
            <div class="m"><b>13–14 Oct</b><span>Two days</span></div>
            <div class="m"><b>Sydney</b><span>CBD · AUSTRALIA</span></div>
            <div class="m"><b>40+ voices</b><span>BUILDERS &amp; LEADERS</span></div>
          </div>
          <p>
            Two days of talks, debate: thinking out loud and building in public; connecting the people making AI with
            the people making meaning with it.
          </p>
        </div>
        <div class="conf-right">
          <div class="tier">
            <div>
              <div class="tn">Community</div>
              <div class="td">Livestream + recordings + community access</div>
            </div>
            <div class="tp">$0</div>
          </div>
          <div class="tier feat">
            <div>
              <div class="tn">Two-day pass</div>
              <div class="td">All stages, workshops &amp; after-hours meetups</div>
            </div>
            <div class="tp">$1000</div>
          </div>
          <div class="tier">
            <div>
              <div class="tn">Founder rate</div>
              <div class="td">Pass + dinners + small-group sessions</div>
            </div>
            <div class="tp">$790</div>
          </div>
          <a
            href={TICKET_URL}
            class="btn"
            target={ticketTarget}
            rel={ticketRel}
            style="margin-top:8px;justify-content:center;background:var(--yellow);color:var(--ink);border-color:var(--yellow)"
            >Secure your seat →</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
