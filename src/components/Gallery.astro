---
import ImageSlot from './ImageSlot.astro';
---

<section id="gallery" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="rv">Scenes from the floor.</h2>
      <span class="sec-num">06 — Gallery</span>
    </div>
    <div class="gal rv">
      <div class="gtile g-a">
        <span class="cap">Main stage · 2025</span><ImageSlot id="g1" placeholder="Stage / keynote" />
      </div>
      <div class="gtile g-b"><ImageSlot id="g2" placeholder="The audience" /></div>
      <div class="gtile g-c"><ImageSlot id="g3" placeholder="Workshop" /></div>
      <div class="gtile g-d">
        <span class="cap">After-hours floor</span><ImageSlot id="g4" placeholder="Networking" />
      </div>
      <div class="gtile g-e"><ImageSlot id="g5" placeholder="Panel / debate" /></div>
      <div class="gtile g-f"><ImageSlot id="g6" placeholder="Detail / signage" /></div>
      <div class="gtile g-g">
        <span class="cap">Shoreditch · London</span><ImageSlot id="g7" placeholder="The venue" />
      </div>
    </div>
    <div style="margin-top:26px"><a href="#" class="btn ghost">See the full gallery →</a></div>
  </div>
</section>
