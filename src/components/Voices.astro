---
import ImageSlot from './ImageSlot.astro';
---

<section id="voices" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="rv">The voices.</h2>
      <span class="sec-num">05 — Speakers</span>
    </div>
    <div class="voices">
      <div class="voice rv">
        <div class="vp"><ImageSlot id="v1" placeholder="Speaker photo" /></div>
        <h4>Speaker Name</h4>
        <p>Creative Director, an agency exploring generative workflows</p>
      </div>
      <div class="voice rv">
        <div class="vp"><ImageSlot id="v2" placeholder="Speaker photo" /></div>
        <h4>Speaker Name</h4>
        <p>Founder, an applied-AI research studio</p>
      </div>
      <div class="voice rv">
        <div class="vp"><ImageSlot id="v3" placeholder="Speaker photo" /></div>
        <h4>Speaker Name</h4>
        <p>Head of Brand, a consumer company facing AI search</p>
      </div>
      <div class="voice rv">
        <div class="vp"><ImageSlot id="v4" placeholder="Speaker photo" /></div>
        <h4>Speaker Name</h4>
        <p>Writer &amp; critic on culture, taste and machines</p>
      </div>
    </div>
    <div style="margin-top:30px;display:flex;gap:12px;align-items:center;flex-wrap:wrap">
      <a href="#" class="btn ghost">See the full lineup →</a><span class="mono" style="color:var(--ink-2)"
        >+ 36 more being announced</span
      >
    </div>
  </div>
</section>
