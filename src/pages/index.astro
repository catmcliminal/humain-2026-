---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Audience from '../components/Audience.astro';
import PulseBand from '../components/PulseBand.astro';
import Lineup from '../components/Lineup.astro';
import Partners from '../components/Partners.astro';
import Conference from '../components/Conference.astro';
import Themes from '../components/Themes.astro';
import Articles from '../components/Articles.astro';
import Gallery from '../components/Gallery.astro';
import Praise from '../components/Praise.astro';
import Contact from '../components/Contact.astro';
import Community from '../components/Community.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout event>
  <Nav />
  <Hero />
  <About />
  <Audience />
  <PulseBand class="mid-pulse" h={104} />
  <Lineup />
  <Partners />
  <Conference />
  <Themes />
  <Articles />
  <Gallery />
  <Praise />
  <Contact />
  <Community />
  <Newsletter />
  <Footer />
</BaseLayout>
