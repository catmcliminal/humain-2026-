---
import { getCollection } from 'astro:content';
import ImageSlot from './ImageSlot.astro';

// Homepage shows the featured speakers; the full lineup lives behind the
// "See the full lineup" link. Sorted by `order` so editors control sequence.
const speakers = (await getCollection('speakers'))
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="voices" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="rv">The voices.</h2>
      <span class="sec-num">05 — Speakers</span>
    </div>
    <div class="voices">
      {
        speakers.map((s) => (
          <div class="voice rv">
            <div class="vp">
              {
                s.data.photo ? (
                  <img src={s.data.photo} alt={s.data.name} loading="lazy" />
                ) : (
                  <ImageSlot placeholder="Speaker photo" />
                )
              }
            </div>
            <h4>{s.data.name}</h4>
            <p set:html={s.data.role} />
          </div>
        ))
      }
    </div>
    <div style="margin-top:30px;display:flex;gap:12px;align-items:center;flex-wrap:wrap">
      <a href="#" class="btn ghost">See the full lineup →</a><span class="mono" style="color:var(--ink-2)"
        >+ 36 more being announced</span
      >
    </div>
  </div>
</section>
