---
import { getCollection } from 'astro:content';
import { featuredFirst } from '../utils/featured';

// The Pulse design is a 7-tile bento grid (g-a … g-g, each a fixed span).
// Homepage shows seven images — featured first, then by `order` to fill — so it
// stays a tidy bento no matter how many photos exist. The rest live at /gallery.
const tileClasses = ['g-a', 'g-b', 'g-c', 'g-d', 'g-e', 'g-f', 'g-g'];

const all = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const images = featuredFirst(all, 7);
---

<section id="gallery" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="rv">Scenes from the floor.</h2>
      <span class="sec-num">06 — Gallery</span>
    </div>
    <div class="gal rv">
      {
        images.map((img, i) => (
          <div class={`gtile ${tileClasses[i % tileClasses.length]}`} role="button" tabindex="0" aria-label={`Enlarge: ${img.data.alt}`} data-lightbox>
            {img.data.caption && <span class="cap">{img.data.caption}</span>}
            <img src={img.data.image} alt={img.data.alt} loading="lazy" />
          </div>
        ))
      }
    </div>
    <div style="margin-top:26px"><a href="/gallery" class="btn ghost">See the full gallery →</a></div>
  </div>
</section>
