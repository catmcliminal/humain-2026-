---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PulseBand from '../../components/PulseBand.astro';
import EarlyBirdNote from '../../components/EarlyBirdNote.astro';
import { breadcrumbJsonLd } from '../../utils/breadcrumbs';
import { currentEdition } from '../../utils/edition';
import { SITE, TICKET_URL, TICKET_IS_EXTERNAL } from '../../config';
import { themeById } from '../../data/themes';
import { dayByDate } from '../../data/days';
import { VENUE } from '../../data/venue';
import { ticketForDay } from '../../data/tickets';
import { UPFRONTS } from '../../data/upfronts';
import '../../styles/session-page.css';

export async function getStaticPaths() {
  const sessions = currentEdition(await getCollection('schedule'));
  return sessions.map((session) => ({
    params: { slug: session.id },
    // Siblings are needed for the "more in this theme" row, and only the
    // current edition's sessions should ever appear there.
    props: { session, siblings: sessions.filter((s) => s.id !== session.id) },
  }));
}

const { session, siblings } = Astro.props;
const d = session.data;

const ticketTarget = TICKET_IS_EXTERNAL ? '_blank' : undefined;
const ticketRel = TICKET_IS_EXTERNAL ? 'noopener noreferrer' : undefined;

const day = dayByDate(d.day);

// Speakers first, then the moderator if there is one — the grid sizes itself
// on the total, and only the moderator's portrait carries a label.
const portraits = [
  ...(d.photos ?? []).map((src) => ({ src, label: undefined as string | undefined })),
  ...(d.moderatorPhoto ? [{ src: d.moderatorPhoto, label: 'Moderator' }] : []),
];

const themes = (d.themes ?? []).map((t) => themeById(t)).filter((t) => t !== undefined);
const primary = themes[0];
const ticket = ticketForDay(d.day);

// Related: sessions sharing any theme, nearest first by running order.
const related = siblings
  .filter((s) => (s.data.themes ?? []).some((t) => (d.themes ?? []).includes(t)))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const url = `${SITE}/programme/${session.id}/`;
const crumbs = breadcrumbJsonLd([
  { name: 'Programme', url: `${SITE}/programme/` },
  { name: d.title, url },
]);

// An Event that is part of the conference — gives each session its own
// rich-result surface and links it back to the parent event.
const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: d.title,
  description: d.hook ?? d.description ?? undefined,
  startDate: d.startTime ? `${d.day}T${d.startTime}:00+11:00` : d.day,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: VENUE,
  superEvent: { '@type': 'Event', name: 'humAIn 2026', url: `${SITE}/` },
  ...(d.speaker ? { performer: { '@type': 'Person', name: d.speaker } } : {}),
  url,
};

const description =
  d.hook ?? d.description?.split('\n\n')[0] ?? `${d.title} — humAIn 2026, Sydney.`;
---

<BaseLayout
  title={`${d.title} | humAIn 2026 Programme`}
  description={description}
  extraJsonLd={[crumbs, eventJsonLd]}
>
  <Nav />
  <main>
    <section class="sp-hero">
      <div class="wrap">
        <nav class="sp-crumb" aria-label="Breadcrumb">
          <a href="/programme">Programme</a>
          {primary && (
            <>
              <span aria-hidden="true">/</span>
              <span>{primary.name}</span>
            </>
          )}
        </nav>

        <div class="sp-grid">
          <div>
            <div class="sp-tags">
              {day && <span class="sp-tag day mono">{day.label}</span>}
              {day && <span class="sp-tag day mono">{day.kind}</span>}
              {d.sessionType && <span class="sp-tag is-kind mono">{d.sessionType}</span>}
              {d.partner && <span class="sp-tag is-partner mono">{d.partner}</span>}
              {d.partner && d.partnerLogo && (
                <span class="sp-partner-logo">
                  <img src={d.partnerLogo} alt={`${d.partner} logo`} loading="eager" />
                </span>
              )}
              {themes.map((t) => <span class="sp-tag is-theme mono">{t.name}</span>)}
            </div>
            <h1>{d.title}</h1>
            {d.hook && <p class="sp-lede">{d.hook}</p>}
            {d.speaker && <p class="sp-speaker">{d.speaker}</p>}
            <div class="sp-acts">
              <a href={TICKET_URL} class="btn" target={ticketTarget} rel={ticketRel}>
                <span class="dot"></span>Get tickets from {ticket.price} →
              </a>
              <a href="/programme" class="btn ghost">See the full programme →</a>
            </div>
          </div>

          {portraits.length > 0 && (
            <div class={`sp-portraits${portraits.length > 1 && portraits.length !== 3 ? ' pair' : ''}${portraits.length === 3 ? ' trio' : ''}`}>
              {portraits.map((p) => (
                <figure class="sp-figure">
                  <img
                    class="sp-portrait"
                    src={p.src}
                    alt={p.label === 'Moderator' ? (d.moderator ?? 'Moderator') : (d.speaker ?? d.title)}
                    width="340"
                    height="425"
                    loading="eager"
                  />
                  {p.label && <figcaption class="sp-figcap mono">{p.label}</figcaption>}
                </figure>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <PulseBand h={60} />

    <section class="sp-body">
      <div class="wrap">
        <div class="sp-body-grid">
          <div>
            {d.description && (
              <>
                <div class="sp-h">About this session</div>
                <div class="sp-prose">
                  {d.description.split('\n\n').map((para) => {
                    // A block whose every line starts with "- " becomes a real
                    // bulleted list. Needs a literal YAML block (`|-`) in the
                    // entry, since a folded one (`>-`) collapses the newlines.
                    const lines = para.split('\n').filter((l) => l.trim());
                    const isList =
                      lines.length > 0 && lines.every((l) => l.trim().startsWith('- '));
                    return isList ? (
                      <ul class="sp-list">
                        {lines.map((l) => <li>{l.trim().slice(2)}</li>)}
                      </ul>
                    ) : (
                      <p>{para}</p>
                    );
                  })}
                </div>
              </>
            )}

            {/* The Upfronts sit behind this single row on /programme, so this
                page is where the individual pitches are listed. */}
            {session.id === 'ai-upfronts' && (
              <div class="sp-upfronts">
                <div class="sp-h">The pitches</div>
                <div class="sp-upfront-grid">
                  {UPFRONTS.map((u) => (
                    <a class="sp-upfront-card" href={`/programme/upfronts/${u.slug}`}>
                      <h3>{u.company}</h3>
                      <p>{u.detail[0]}</p>
                      {u.speaker && <div class="sp-rwho">{u.speaker}</div>}
                    </a>
                  ))}
                </div>
              </div>
            )}

            {themes.length > 0 && (
              <div class="sp-themebar">
                <div class="sp-h">Explore the themes this sits in</div>
                <div class="sp-chips">
                  {themes.map((t) => (
                    <span class="sp-chip">{t.name}</span>
                  ))}
                </div>
              </div>
            )}
          </div>

          <aside class="sp-aside">
            <div class="sp-h">{ticket.days}</div>
            <div class="sp-amt">
              {ticket.price}
            </div>
            <p class="sp-ex">{ticket.name}, ex GST</p>
            <a href={TICKET_URL} class="btn" target={ticketTarget} rel={ticketRel}>
              <span class="dot"></span>Get tickets →
            </a>
            <EarlyBirdNote />
          </aside>
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="sp-related">
        <div class="wrap">
          <div class="sec-head">
            <h2 class="rv">More in this theme</h2>
            <span class="sec-num">— Related</span>
          </div>
          <div class="sp-rel-grid">
            {related.map((s) => (
              <a class="sp-rcard rv" href={`/programme/${s.id}`}>
                <div class="sp-tags">
                  <span class="sp-tag day mono">
                    {dayByDate(s.data.day)?.label}
                  </span>
                </div>
                <h3>{s.data.title}</h3>
                {s.data.hook && <p>{s.data.hook}</p>}
                {s.data.speaker && <div class="sp-rwho">{s.data.speaker}</div>}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section style="padding-top:0">
      <div class="wrap">
        <div class="sec-cta rv">
          <a href={TICKET_URL} class="btn" target={ticketTarget} rel={ticketRel}>
            <span class="dot"></span>Get tickets →
          </a>
          <EarlyBirdNote />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

