---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PulseBand from '../components/PulseBand.astro';
import { PRINCIPLES, ACCENTS } from '../data/manifesto';
import { SITE } from '../config';
import { breadcrumbJsonLd } from '../utils/breadcrumbs';

const crumbs = breadcrumbJsonLd([{ name: 'Manifesto', url: `${SITE}/manifesto/` }]);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title="A manifesto for creatives in the AI era | humAIn"
  description="We make stories. This one is about us. Eleven principles for creatives in the AI era — stand with them, annotate them, add to them, and sign."
  extraJsonLd={[crumbs]}
>
  <Nav />
  <main class="mf">
    <header class="mf-head wrap">
      <span class="eyebrow"><span class="tk"></span><span class="mono">A manifesto for creatives in the AI era</span></span>
      <h1>We make stories. <em>This one is about us.</em></h1>
      <div class="mf-head-row">
        <div class="mf-intro">
          <p>We didn’t get decades to build the roads. The machines are already here, and we’re being asked to transform our working lives while the destination keeps shifting.</p>
          <p>This technological disruption requires one of our most ancient technologies: story. A future we can dream into being. A meaningful role for ourselves within it. Something worth working towards.</p>
          <p class="mf-statement">Don’t surrender your judgement. Keep asking. Keep choosing. Decide where you yield and where you stand.</p>
        </div>
        <div class="mf-side">
          <dl class="mf-stats">
            <div><dt>Standing</dt><dd data-stat="stands">0</dd></div>
            <div><dt>Margin notes</dt><dd data-stat="notes">0</dd></div>
            <div><dt>Signatories</dt><dd data-stat="signs">0</dd></div>
          </dl>
          <p class="mf-how">Stand with a principle. Select any sentence to leave a note in the margin. Add a line. Propose a twelfth. Then sign it, or don’t.</p>
        </div>
      </div>
      <div class="mf-pulse"><PulseBand h={130} /></div>
    </header>

    <div class="wrap mf-principles">
      {PRINCIPLES.map((p, i) => (
        <article
          id={`principle-${p.n}`}
          data-pid={`p${p.n}`}
          style={`--acc:${ACCENTS[i % 5]};--acc-ink:${ACCENTS[i % 5] === '#FFC21A' ? '#0B0908' : '#fff'}`}
        >
          <div class="mf-body">
            <div class="mf-eyebrow">Principle {pad(p.n)}</div>
            <h2>{p.title}</h2>
            <p class="mf-text" data-text>{p.body}</p>
            {p.quote && (
              <blockquote>
                <p>{p.quote}</p>
                <cite>{p.cite}</cite>
              </blockquote>
            )}
            <div class="mf-lines" data-lines></div>
            <div class="mf-card mf-composer" data-line-composer hidden>
              <label for={`line-${p.n}`} class="mf-label">Add a line to this principle</label>
              <textarea id={`line-${p.n}`} class="mf-field" rows="2" maxlength="300" placeholder="One sentence. Say it plainly." data-line-text></textarea>
              <div class="mf-row">
                <input class="mf-field mf-name" maxlength="60" placeholder="Your name (optional)" data-by aria-label="Your name (optional)" />
                <button type="button" class="mf-pill primary" data-line-post>Add it →</button>
                <button type="button" class="mf-text-btn" data-line-cancel>Cancel</button>
              </div>
            </div>
            <div class="mf-actions">
              <button type="button" class="mf-pill" data-stand aria-pressed="false">
                <span class="mf-dot"></span><span data-stand-label>Stand with this</span><span class="mf-count" data-stand-count>0</span>
              </button>
              <button type="button" class="mf-pill mf-ghost" data-line-open>+ Add a line</button>
              <span class="mf-hint">Select a sentence to annotate</span>
            </div>
          </div>
          <aside class="mf-margin">
            <div class="mf-margin-head"><span>Margin</span><span data-note-count>00</span></div>
            <div class="mf-card mf-composer mf-note-composer" data-note-composer hidden>
              <p class="mf-quote" data-note-quote></p>
              <textarea class="mf-field" rows="3" maxlength="600" placeholder="Agree, push back, add context." data-note-text aria-label="Your note"></textarea>
              <input class="mf-field mf-name" maxlength="60" placeholder="Your name (optional)" data-by aria-label="Your name (optional)" />
              <div class="mf-row">
                <button type="button" class="mf-pill primary" data-note-post>Post note →</button>
                <button type="button" class="mf-text-btn" data-note-cancel>Cancel</button>
              </div>
            </div>
            <div class="mf-notes" data-notes></div>
            <p class="mf-empty" data-empty>Nothing in the margin yet. Highlight a sentence and say what you think.</p>
          </aside>
        </article>
      ))}
      <p class="mf-closing">Your experience is where the work comes from. <em>Give yourself a life to draw on.</em></p>
    </div>

    <section id="propose" class="wrap mf-section">
      <div class="sec-head">
        <h2>The twelfth.</h2>
        <span class="sec-num mono">Proposed by the room</span>
      </div>
      <p class="mf-propose-intro">Eleven is where we stopped, not where it ends. Propose what’s missing. The room decides what stands.</p>
      <div class="mf-grid" data-grid>
        <div class="mf-tile mf-form" data-propose>
          <div class="mf-pink-label">Propose a principle</div>
          <input class="mf-field mf-prop-title" maxlength="80" placeholder="Title. Short. Imperative." data-prop-title aria-label="Title" />
          <textarea class="mf-field" rows="4" maxlength="500" placeholder="Two or three sentences. Why this, why now." data-prop-body aria-label="Why this, why now"></textarea>
          <input class="mf-field mf-name" maxlength="60" placeholder="Your name (optional)" data-by aria-label="Your name (optional)" />
          <div><button type="button" class="mf-pill primary" data-prop-post>Propose it →</button></div>
        </div>
      </div>
    </section>

    <section id="sign" class="wrap mf-section">
      <div class="mf-sign">
        <div class="mf-sign-copy">
          <h2>Put your name to it.</h2>
          <p>Signing says you stand behind this, in public. Your name and city go on the wall below.</p>
        </div>
        <div class="mf-sign-side">
          <div class="mf-sign-form" data-sign-form>
            <input class="mf-sign-field" maxlength="60" placeholder="Full name" data-sign-name aria-label="Full name" autocomplete="name" />
            <input class="mf-sign-field" maxlength="60" placeholder="City" data-sign-city aria-label="City" autocomplete="address-level2" />
            <div class="mf-row">
              <button type="button" class="nform-btn" data-sign-post>Sign the manifesto →</button>
              <span class="mf-sign-error" data-sign-error role="alert"></span>
            </div>
          </div>
          <div class="mf-signed" data-signed hidden>
            <span class="mf-label">Signed</span>
            <span class="mf-signed-name" data-signed-name></span>
            <span class="mf-signed-note">You’re on the wall. Thank you.</span>
          </div>
        </div>
      </div>
      <div class="mf-wall-head"><span>Signatories</span><span data-stat="signs">0</span></div>
      <div class="mf-wall" data-wall></div>
    </section>

    <button type="button" class="mf-annotate" data-annotate hidden>Annotate this →</button>
    <div class="mf-toast" data-toast role="status" hidden></div>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .mf { padding-bottom: 96px; }
  .mf em { font-style: normal; color: var(--pink); }

  /* Head */
  .mf-head { padding-top: 76px; }
  .mf-head .eyebrow { margin-bottom: 30px; }
  .mf-head h1 { font-family: var(--disp); font-weight: 800; font-size: clamp(44px, 7.4vw, 112px); line-height: .92; letter-spacing: -.03em; text-wrap: balance; max-width: 14ch; margin: 0; }
  .mf-head-row { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-end; margin-top: 48px; }
  .mf-intro { flex: 1 1 520px; min-width: 0; max-width: 680px; display: flex; flex-direction: column; gap: 20px; font-size: 19px; line-height: 1.5; color: #fff; }
  .mf-intro p { margin: 0; }
  .mf-intro .mf-statement { margin-top: 12px; font-family: var(--disp); font-weight: 700; font-size: clamp(20px, 2.2vw, 28px); line-height: 1.2; letter-spacing: -.015em; }
  .mf-side { flex: 0 1 320px; display: flex; flex-direction: column; gap: 16px; padding-bottom: 6px; }
  .mf-stats { margin: 0; display: flex; flex-direction: column; gap: 14px; font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }
  .mf-stats div { display: flex; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--line); padding-bottom: 12px; }
  .mf-stats dt, .mf-stats dd { margin: 0; }
  .mf-stats dd { color: var(--ink); }
  .mf-how { margin: 0; font-size: 14px; line-height: 1.5; color: var(--ink-2); }
  .mf-pulse { margin-top: 40px; height: 130px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

  /* Principles */
  .mf-principles { padding-top: 24px; }
  .mf-principles article { display: flex; flex-wrap: wrap; gap: 40px 64px; padding: 56px 0 60px; border-bottom: 1px solid var(--line); scroll-margin-top: 80px; }
  .mf-body { flex: 1 1 520px; min-width: 0; max-width: 720px; }
  .mf-eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 18px; }
  .mf-principles h2 { font-family: var(--disp); font-weight: 800; font-size: clamp(28px, 3.6vw, 46px); line-height: 1; letter-spacing: -.025em; margin: 0 0 22px; text-wrap: balance; }
  .mf-text { font-size: 18px; line-height: 1.6; color: #fff; margin: 0; cursor: text; }
  .mf-text mark { background: color-mix(in srgb, var(--acc) 20%, transparent); box-shadow: inset 0 -2px 0 var(--acc); border-radius: 2px; color: inherit; }
  .mf-body blockquote { margin: 28px 0 0; padding: 4px 0 4px 22px; border-left: 3px solid var(--pink); }
  .mf-body blockquote p { margin: 0; font-family: var(--disp); font-weight: 700; font-size: clamp(20px, 2.2vw, 27px); line-height: 1.25; letter-spacing: -.015em; }
  .mf-body cite { display: block; margin-top: 12px; font-style: normal; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }
  .mf-lines { display: flex; flex-direction: column; gap: 14px; }
  .mf-lines:not(:empty) { margin-top: 28px; }
  .mf-line { display: flex; gap: 16px; align-items: flex-start; padding: 16px 18px; border: 1px solid var(--line-2); border-radius: 14px; background: var(--panel); }
  .mf-line > div { flex: 1; min-width: 0; }
  .mf-line p { margin: 0; font-size: 16px; line-height: 1.5; color: #fff; overflow-wrap: anywhere; }
  .mf-by { font-family: var(--mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }
  .mf-line .mf-by { margin-top: 8px; }

  .mf-card { display: flex; flex-direction: column; gap: 10px; padding: 18px; border: 1px solid var(--line-2); border-radius: 14px; background: var(--panel); }
  .mf-card[hidden], .mf-annotate[hidden], .mf-toast[hidden], .mf-signed[hidden], .mf-sign-form[hidden], .mf-empty[hidden] { display: none; }
  .mf-composer { margin-top: 20px; }
  .mf-note-composer { margin-top: 0; border-color: var(--pink); }
  .mf-label { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }
  .mf-quote { margin: 0; font-size: 14px; line-height: 1.45; color: var(--ink-2); }
  .mf-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .mf-name { flex: 1 1 160px; }

  .mf-field { width: 100%; background: var(--paper); border: 1px solid var(--line-2); border-radius: 10px; padding: 11px 16px; font-family: var(--sans); font-size: 15px; color: var(--ink); }
  textarea.mf-field { padding: 12px 16px; resize: vertical; line-height: 1.5; }
  .mf-name { font-size: 14px; }
  .mf-field:focus, .mf-sign-field:focus { outline: none; border-color: var(--pink); box-shadow: 0 0 0 3px rgba(240, 55, 154, .12); }
  .mf-field::placeholder { color: var(--ink-2); }

  /* Pills */
  .mf-pill { display: inline-flex; align-items: center; gap: 9px; font-family: var(--sans); font-weight: 700; font-size: 14px; padding: 12px 20px; border-radius: 100px; cursor: pointer; transition: .2s; border: 1px solid var(--line-2); background: transparent; color: var(--ink); }
  .mf-pill:hover { border-color: var(--pink); }
  .mf-pill:focus-visible, .mf-annotate:focus-visible, .mf-text-btn:focus-visible { outline: 3px solid var(--pink); outline-offset: 3px; }
  .mf-pill.sm { font-size: 12px; padding: 7px 13px; gap: 7px; white-space: nowrap; }
  .mf-pill.is-on { background: var(--acc); border-color: var(--acc); color: var(--acc-ink); }
  .mf-pill.primary { background: var(--ink); border-color: var(--ink); color: #0b0908; padding: 11px 18px; }
  .mf-pill.primary:hover { background: var(--pink); border-color: var(--pink); color: #fff; }
  .mf-ghost:hover { background: var(--ink); color: #0b0908; border-color: var(--ink); }
  .mf-actions .mf-pill[data-stand]:hover { transform: translateY(-1px); }
  .mf-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: currentColor; opacity: .9; }
  .mf-count { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; opacity: .8; }
  .mf-text-btn { background: none; border: 0; color: var(--ink-2); font-family: var(--sans); font-size: 14px; cursor: pointer; padding: 8px; }
  .mf-text-btn:hover { color: var(--ink); }
  .mf-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 30px; }
  .mf-hint { font-family: var(--mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }

  /* Margin */
  .mf-margin { flex: 1 1 280px; min-width: 0; max-width: 420px; display: flex; flex-direction: column; gap: 12px; padding-top: 6px; }
  .mf-margin-head { display: flex; justify-content: space-between; align-items: baseline; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); border-bottom: 1px solid var(--line); padding-bottom: 10px; }
  .mf-notes { display: flex; flex-direction: column; gap: 12px; }
  .mf-note { transition: .25s; }
  .mf-note:hover { background: var(--panel-2); }
  .mf-note .mf-quote { font-size: 13px; }
  .mf-note-text { margin: 0; font-size: 15px; line-height: 1.5; color: #fff; overflow-wrap: anywhere; }
  .mf-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 10px; border-top: 1px solid var(--line); }
  .mf-empty { margin: 0; font-size: 14px; line-height: 1.5; color: var(--ink-2); }

  .mf-closing { margin: 0; padding: 72px 0 0; font-family: var(--disp); font-weight: 800; font-size: clamp(26px, 3.6vw, 48px); line-height: 1.05; letter-spacing: -.025em; max-width: 22ch; text-wrap: balance; }

  /* The twelfth */
  .mf-section { padding-top: 96px; }
  .mf-section .sec-head { margin-bottom: 40px; }
  .mf-propose-intro { margin: 0 0 32px; font-size: 17px; line-height: 1.55; color: #fff; max-width: 56ch; }
  .mf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
  .mf-tile { display: flex; flex-direction: column; gap: 14px; padding: 28px 26px; border: 1px solid var(--line-2); border-radius: 16px; background: var(--panel); transition: .25s; }
  .mf-form { gap: 12px; }
  .mf-form:hover { transform: none; background: var(--panel); }
  .mf-pink-label { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--pink); }
  .mf-prop-title { font-size: 16px; font-weight: 700; padding: 12px 16px; }
  .mf-prop { }
  .mf-prop:hover { background: var(--panel-2); transform: translateY(-4px); }
  .mf-prop .mf-eyebrow { margin: 0; font-size: 11px; }
  .mf-prop h3 { margin: 0; font-family: var(--disp); font-weight: 800; font-size: 24px; line-height: 1.06; letter-spacing: -.015em; overflow-wrap: anywhere; }
  .mf-prop p { margin: 0; flex: 1; font-size: 15px; line-height: 1.55; color: #fff; overflow-wrap: anywhere; }
  .mf-prop .mf-foot { padding-top: 14px; }

  /* Sign */
  .mf-sign { background: var(--pink); color: #fff; border-radius: 22px; padding: 56px; display: flex; flex-wrap: wrap; gap: 40px; align-items: center; }
  .mf-sign-copy { flex: 1 1 380px; min-width: 0; }
  .mf-sign-copy h2 { margin: 0; font-family: var(--disp); font-weight: 800; font-size: clamp(32px, 4.4vw, 58px); line-height: .94; letter-spacing: -.02em; }
  .mf-sign-copy p { margin: 16px 0 0; font-size: 16px; line-height: 1.5; max-width: 40ch; color: #fff; }
  .mf-sign-side { flex: 1 1 320px; min-width: 0; }
  .mf-sign-form { display: flex; flex-direction: column; gap: 10px; }
  .mf-sign-form .mf-row { gap: 14px; }
  .mf-sign-field { width: 100%; background: #0b0908; border: 1px solid #0b0908; border-radius: 10px; padding: 14px 18px; font-family: var(--sans); font-size: 15px; color: var(--ink); }
  .mf-sign-error { font-size: 13px; color: #ffe6f3; }
  .mf-signed { display: flex; flex-direction: column; gap: 8px; padding: 24px 28px; background: #0b0908; border-radius: 14px; }
  .mf-signed-name { font-family: var(--disp); font-weight: 700; font-size: 22px; letter-spacing: -.01em; overflow-wrap: anywhere; }
  .mf-signed-note { font-size: 14px; color: var(--ink-2); }
  .mf-wall-head { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; margin: 64px 0 24px; border-bottom: 1px solid var(--line); padding-bottom: 16px; font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }
  .mf-wall { display: flex; flex-wrap: wrap; gap: 10px 28px; font-size: 15px; line-height: 1.5; color: #fff; }
  .mf-wall span span, .mf-wall .mf-more { color: var(--ink-2); }

  /* Floating bits */
  .mf-annotate { position: fixed; z-index: 200; transform: translate(-50%, -100%); background: var(--ink); color: var(--paper); border: 0; border-radius: 100px; padding: 10px 16px; font-family: var(--sans); font-size: 13px; font-weight: 700; cursor: pointer; box-shadow: 0 8px 24px rgba(0, 0, 0, .45); }
  .mf-toast { position: fixed; z-index: 200; left: 50%; bottom: 24px; transform: translateX(-50%); background: var(--ink); color: var(--paper); border-radius: 100px; padding: 12px 20px; font-size: 14px; font-weight: 700; box-shadow: 0 8px 24px rgba(0, 0, 0, .45); max-width: calc(100vw - 32px); }

  @media (max-width: 760px) {
    .mf-sign { padding: 44px 30px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mf-pill, .mf-tile, .mf-note { transition: none; }
    .mf-prop:hover, .mf-actions .mf-pill[data-stand]:hover { transform: none; }
  }
</style>

<script>
  import { PRINCIPLES } from '../data/manifesto';

  interface Note { id: string; pid: string; quote: string; text: string; by: string; n: number }
  interface Line { id: string; pid: string; text: string; by: string; n: number }
  interface Proposal { id: string; title: string; body: string; by: string; n: number }
  interface State {
    votes: Record<string, number>;
    notes: Note[];
    lines: Line[];
    proposals: Proposal[];
    signs: { name: string; city: string }[];
    mine: string[];
    mySign: { name: string; city: string } | null;
  }

  const API = '/api/manifesto';
  const WALL_LIMIT = 48;
  const bodies = new Map(PRINCIPLES.map((p) => [`p${p.n}`, p.body]));

  const $ = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) =>
    root.querySelector<T>(sel);
  const $$ = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) =>
    Array.from(root.querySelectorAll<T>(sel));

  function h<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    props: Record<string, string> = {},
    ...kids: (Node | string)[]
  ): HTMLElementTagNameMap[K] {
    const el = document.createElement(tag);
    for (const [k, v] of Object.entries(props)) el.setAttribute(k, v);
    el.append(...kids);
    return el;
  }

  let state: State | null = null;
  let draftName = '';
  const mine = new Set<string>();

  /* ---------- talking to the API ---------- */

  const toast = $('[data-toast]')!;
  let toastTimer: number | undefined;
  function say(msg: string) {
    toast.textContent = msg;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (toast.hidden = true), 4000);
  }

  function adopt(next: State) {
    state = next;
    mine.clear();
    next.mine.forEach((k) => mine.add(k));
    render();
  }

  async function load() {
    try {
      const res = await fetch(API);
      if (res.ok) adopt(await res.json());
    } catch {
      /* page stays readable without the live numbers */
    }
  }

  async function send(payload: Record<string, unknown>): Promise<string | null> {
    try {
      const res = await fetch(API, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) return data.error ?? 'Couldn’t save that. Please try again.';
      adopt(data);
      return null;
    } catch {
      return 'Couldn’t save that. Please try again.';
    }
  }

  /** Optimistic stand/agree toggle; reload the truth if the server disagrees. */
  async function toggle(key: string) {
    if (!state) return;
    const on = mine.has(key);
    const bump = (n: number) => Math.max(0, n + (on ? -1 : 1));
    on ? mine.delete(key) : mine.add(key);
    const [kind, id] = key.split(':');
    if (!id) state.votes[key] = bump(state.votes[key] ?? 0);
    else {
      const item = (kind === 'n' ? state.notes : kind === 'l' ? state.lines : state.proposals).find((x) => x.id === id);
      if (item) item.n = bump(item.n);
    }
    render();
    const err = await send({ action: 'toggle', key });
    if (err) {
      say(err);
      load();
    }
  }

  /* ---------- rendering ---------- */

  const pad = (n: number) => String(n).padStart(2, '0');

  function pillState(btn: HTMLElement, on: boolean) {
    btn.classList.toggle('is-on', on);
    btn.setAttribute('aria-pressed', String(on));
  }

  function smallPill(key: string, onWord: string, offWord: string, n: number) {
    const on = mine.has(key);
    const b = h('button', { type: 'button', class: 'mf-pill sm' }, `${on ? onWord : offWord} · ${n}`);
    pillState(b, on);
    b.addEventListener('click', () => toggle(key));
    return b;
  }

  /** Split the body into plain runs and highlighted runs for sentences that have notes. */
  function highlighted(body: string, quotes: string[]): (Node | string)[] {
    const out: (Node | string)[] = [];
    let rest = body;
    while (rest) {
      let at = -1;
      let hit = '';
      for (const q of quotes) {
        const k = rest.indexOf(q);
        if (k > -1 && (at < 0 || k < at)) {
          at = k;
          hit = q;
        }
      }
      if (at < 0) {
        out.push(rest);
        break;
      }
      if (at > 0) out.push(rest.slice(0, at));
      out.push(h('mark', {}, hit));
      rest = rest.slice(at + hit.length);
    }
    return out;
  }

  function render() {
    if (!state) return;
    const s = state;
    const stands = Object.values(s.votes).reduce((a, b) => a + b, 0);
    $$('[data-stat="stands"]').forEach((el) => (el.textContent = String(stands)));
    $$('[data-stat="notes"]').forEach((el) => (el.textContent = String(s.notes.length)));
    $$('[data-stat="signs"]').forEach((el) => (el.textContent = String(s.signs.length)));

    for (const art of $$('article[data-pid]')) {
      const pid = art.dataset.pid!;
      const notes = s.notes.filter((n) => n.pid === pid);

      const stand = $('[data-stand]', art)!;
      pillState(stand, mine.has(pid));
      $('[data-stand-label]', art)!.textContent = mine.has(pid) ? 'Standing with this' : 'Stand with this';
      $('[data-stand-count]', art)!.textContent = String(s.votes[pid] ?? 0);

      // Don't rebuild the paragraph while someone is mid-selection inside it.
      const text = $('[data-text]', art)!;
      const quotes = notes.map((n) => n.quote);
      if (text.dataset.marked !== quotes.join('|')) {
        text.replaceChildren(...highlighted(bodies.get(pid)!, quotes));
        text.dataset.marked = quotes.join('|');
      }

      $('[data-lines]', art)!.replaceChildren(
        ...s.lines
          .filter((l) => l.pid === pid)
          .map((l) =>
            h('div', { class: 'mf-line' },
              h('div', {}, h('p', {}, l.text), h('div', { class: 'mf-by' }, `Added by ${l.by}`)),
              smallPill('l:' + l.id, 'Standing', 'Stand', l.n)),
          ),
      );

      $('[data-note-count]', art)!.textContent = pad(notes.length);
      $('[data-notes]', art)!.replaceChildren(
        ...notes.map((n) =>
          h('div', { class: 'mf-card mf-note' },
            h('p', { class: 'mf-quote' }, `“${n.quote}”`),
            h('p', { class: 'mf-note-text' }, n.text),
            h('div', { class: 'mf-foot' }, h('span', { class: 'mf-by' }, n.by), smallPill('n:' + n.id, 'Agreed', 'Agree', n.n))),
        ),
      );
      $('[data-empty]', art)!.hidden = notes.length > 0 || !$('[data-note-composer]', art)!.hidden;
    }

    // The twelfth: most-stood first.
    const grid = $('[data-grid]')!;
    $$('.mf-prop', grid).forEach((el) => el.remove());
    [...s.proposals]
      .sort((a, b) => b.n - a.n)
      .forEach((x, r) => {
        grid.append(
          h('div', { class: 'mf-tile mf-prop' },
            h('div', { class: 'mf-eyebrow' }, `Proposed ${pad(12 + r)}`),
            h('h3', {}, x.title),
            h('p', {}, x.body),
            h('div', { class: 'mf-foot' }, h('span', { class: 'mf-by' }, x.by), smallPill('x:' + x.id, 'Standing', 'Stand', x.n))),
        );
      });

    // Signatures
    const form = $('[data-sign-form]')!;
    const signed = $('[data-signed]')!;
    form.hidden = !!s.mySign;
    signed.hidden = !s.mySign;
    if (s.mySign) $('[data-signed-name]')!.textContent = `${s.mySign.name}, ${s.mySign.city}`;
    const newest = [...s.signs].reverse();
    const wall = newest.slice(0, WALL_LIMIT).map((x) => h('span', {}, x.name, h('span', {}, `, ${x.city}`)));
    if (newest.length > WALL_LIMIT) wall.push(h('span', { class: 'mf-more' }, `and ${newest.length - WALL_LIMIT} more`));
    $('[data-wall]')!.replaceChildren(...wall);
  }

  /* ---------- composers ---------- */

  // The name field is shared across every composer for the session.
  const nameInputs = $$<HTMLInputElement>('[data-by]');
  nameInputs.forEach((input) =>
    input.addEventListener('input', () => {
      draftName = input.value;
      nameInputs.forEach((o) => o !== input && (o.value = draftName));
    }),
  );

  let openNote: HTMLElement | null = null;
  let openLine: HTMLElement | null = null;

  function closeNote() {
    if (openNote) openNote.hidden = true;
    openNote = null;
    render();
  }
  function closeLine() {
    if (openLine) openLine.hidden = true;
    openLine = null;
  }

  for (const art of $$('article[data-pid]')) {
    const pid = art.dataset.pid!;

    $('[data-stand]', art)!.addEventListener('click', () => toggle(pid));

    // Add a line
    const lineBox = $('[data-line-composer]', art)!;
    const lineText = $<HTMLTextAreaElement>('[data-line-text]', art)!;
    $('[data-line-open]', art)!.addEventListener('click', () => {
      closeLine();
      lineBox.hidden = false;
      openLine = lineBox;
      lineText.focus();
    });
    $('[data-line-cancel]', art)!.addEventListener('click', closeLine);
    $('[data-line-post]', art)!.addEventListener('click', async () => {
      const text = lineText.value.trim();
      if (!text) return;
      const err = await send({ action: 'line', pid, text, by: draftName });
      if (err) return say(err);
      lineText.value = '';
      closeLine();
    });

    // Margin note
    const noteBox = $('[data-note-composer]', art)!;
    const noteText = $<HTMLTextAreaElement>('[data-note-text]', art)!;
    $('[data-note-cancel]', art)!.addEventListener('click', closeNote);
    $('[data-note-post]', art)!.addEventListener('click', async () => {
      const text = noteText.value.trim();
      if (!text) return;
      const quote = noteBox.dataset.quote ?? '';
      const err = await send({ action: 'note', pid, quote, text, by: draftName });
      if (err) return say(err);
      noteText.value = '';
      closeNote();
    });
  }

  // Propose a twelfth
  const propTitle = $<HTMLInputElement>('[data-prop-title]')!;
  const propBody = $<HTMLTextAreaElement>('[data-prop-body]')!;
  $('[data-prop-post]')!.addEventListener('click', async () => {
    if (!propTitle.value.trim() || !propBody.value.trim()) return;
    const err = await send({ action: 'propose', title: propTitle.value, body: propBody.value, by: draftName });
    if (err) return say(err);
    propTitle.value = '';
    propBody.value = '';
  });

  // Sign
  const signName = $<HTMLInputElement>('[data-sign-name]')!;
  const signCity = $<HTMLInputElement>('[data-sign-city]')!;
  const signError = $('[data-sign-error]')!;
  $('[data-sign-post]')!.addEventListener('click', async () => {
    if (!signName.value.trim() || !signCity.value.trim()) {
      signError.textContent = 'Name and city, please.';
      return;
    }
    signError.textContent = '';
    const err = await send({ action: 'sign', name: signName.value, city: signCity.value });
    if (err) signError.textContent = err;
  });

  /* ---------- annotate-a-sentence ---------- */

  const pill = $('[data-annotate]')!;
  let selection: { article: HTMLElement; text: string; range: Range } | null = null;

  function readSelection() {
    const sel = window.getSelection();
    const text = sel ? sel.toString().trim() : '';
    const node = sel?.anchorNode;
    const para = node ? (node.nodeType === 1 ? (node as HTMLElement) : node.parentElement)?.closest<HTMLElement>('[data-text]') : null;
    if (!sel || !para || text.length < 4 || !para.contains(sel.focusNode)) {
      hidePill();
      return;
    }
    selection = { article: para.closest('article')!, text, range: sel.getRangeAt(0).cloneRange() };
    placePill();
  }

  function placePill() {
    if (!selection) return;
    const r = selection.range.getBoundingClientRect();
    pill.style.left = `${r.left + r.width / 2}px`;
    pill.style.top = `${r.top - 12}px`;
    pill.hidden = false;
  }

  function hidePill() {
    selection = null;
    pill.hidden = true;
  }

  let selTimer: number | undefined;
  document.addEventListener('mouseup', (e) => {
    if ((e.target as HTMLElement).closest('[data-annotate]')) return;
    setTimeout(readSelection, 0);
  });
  document.addEventListener('selectionchange', () => {
    clearTimeout(selTimer);
    selTimer = window.setTimeout(readSelection, 250);
  });
  document.addEventListener('mousedown', (e) => {
    if (!(e.target as HTMLElement).closest('[data-annotate]')) hidePill();
  });
  window.addEventListener('scroll', placePill, { passive: true });

  pill.addEventListener('click', () => {
    if (!selection) return;
    const { article, text } = selection;
    closeNote();
    const box = $('[data-note-composer]', article)!;
    box.dataset.quote = text;
    $('[data-note-quote]', article)!.textContent = `“${text}”`;
    box.hidden = false;
    openNote = box;
    $('[data-empty]', article)!.hidden = true;
    hidePill();
    window.getSelection()?.removeAllRanges();
    $<HTMLTextAreaElement>('[data-note-text]', article)!.focus();
  });

  load();
</script>
