---
interface Props {
  url: string;
}

const { url } = Astro.props;

function getEmbedUrl(raw: string): { src: string; title: string } | null {
  // YouTube: watch?v=, youtu.be/, /embed/, /shorts/
  const yt = raw.match(
    /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/
  );
  if (yt) return { src: `https://www.youtube.com/embed/${yt[1]}`, title: 'YouTube video' };

  // Vimeo: vimeo.com/<id> or player.vimeo.com/video/<id>
  const vimeo = raw.match(/(?:vimeo\.com\/|player\.vimeo\.com\/video\/)(\d+)/);
  if (vimeo) return { src: `https://player.vimeo.com/video/${vimeo[1]}`, title: 'Vimeo video' };

  return null;
}

const embed = getEmbedUrl(url);
---

{embed ? (
  <div class="video-embed">
    <iframe
      src={embed.src}
      title={embed.title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
    ></iframe>
  </div>
) : (
  <p class="video-embed-error">Video could not be embedded — unsupported URL: {url}</p>
)}

<style>
  .video-embed {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    overflow: hidden;
    margin: 2rem 0;
    border-radius: 4px;
  }
  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-embed-error {
    color: #c00;
    font-style: italic;
  }
</style>
