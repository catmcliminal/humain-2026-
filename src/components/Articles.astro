---
import { getCollection } from 'astro:content';

// Homepage shows the three most recent published articles.
const articles = (await getCollection('news'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

// When an article has no cover image we fall back to one of the three
// decorative patterns from the original design, cycled by position. Pattern
// ids are suffixed with the entry id so multiple cards stay valid SVG.
function patternSvg(index: number, key: string): string {
  const id = `pat-${key}`;
  const patterns = [
    `<defs><pattern id="${id}" width="14" height="14" patternTransform="rotate(45)" patternUnits="userSpaceOnUse"><rect width="14" height="14" fill="#f0379a"></rect><rect width="7" height="14" fill="#f0531f"></rect></pattern></defs><rect width="100%" height="100%" fill="url(#${id})" opacity="0.9"></rect>`,
    `<defs><pattern id="${id}" width="16" height="16" patternUnits="userSpaceOnUse"><rect width="16" height="16" fill="#1a50c8"></rect><circle cx="8" cy="8" r="3" fill="#ffc21a"></circle></pattern></defs><rect width="100%" height="100%" fill="url(#${id})"></rect>`,
    `<defs><pattern id="${id}" width="18" height="18" patternTransform="rotate(135)" patternUnits="userSpaceOnUse"><rect width="18" height="18" fill="#0e5a30"></rect><rect width="9" height="18" fill="#f0379a"></rect></pattern></defs><rect width="100%" height="100%" fill="url(#${id})" opacity="0.92"></rect>`,
  ];
  return patterns[index % patterns.length];
}
---

<section id="articles" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="rv">Thinking out loud.</h2>
      <span class="sec-num">04 — Media &amp; articles</span>
    </div>
    <div class="arts">
      {
        articles.map((a, i) => (
          <a class="art rv" href={`/news/${a.id}/`}>
            <div class="ph">
              {
                a.data.coverImage ? (
                  <img src={a.data.coverImage} alt={a.data.title} loading="lazy" />
                ) : (
                  <svg set:html={patternSvg(i, a.id)} />
                )
              }
            </div>
            <div class="cat">{a.data.category}</div>
            <h3>{a.data.title}</h3>
            <div class="meta">
              {a.data.readingTime && (
                <>
                  <span>{a.data.readingTime}</span>
                  <span class="d" />
                </>
              )}
              <span>by {a.data.author}</span>
            </div>
          </a>
        ))
      }
    </div>
    <div style="margin-top:28px"><a href="#" class="btn ghost">Browse all media →</a></div>
  </div>
</section>
