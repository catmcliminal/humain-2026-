---
/**
 * Animated ECG/heartbeat band. Path geometry is generated client-side by
 * buildPulses() in BaseLayout. The shared #pgrad gradient lives in the
 * top-level hidden SVG in BaseLayout — not here.
 */
interface Props {
  class?: string;
  h: number;
}

const { class: className, h } = Astro.props;
---

<div class:list={['pulse-band', className]} data-h={h}>
  <svg preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path class="ecg-base" pathLength="100" d=""></path>
    <path class="ecg-run" pathLength="100" d=""></path>
    <path class="ecg-head" pathLength="100" d=""></path>
  </svg>
</div>
