---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import { breadcrumbJsonLd } from '../../utils/breadcrumbs';
import { SITE } from '../../config';

const crumbs = breadcrumbJsonLd([
  { name: 'About', url: `${SITE}/about/` },
  { name: 'Gift Register', url: `${SITE}/about/gift-register/` },
]);

// Newest first — a register reads chronologically, so there's no `order` field.
const entries = (await getCollection('gifts', ({ data }) => data.published)).sort(
  (a, b) => b.data.dateReceived.valueOf() - a.data.dateReceived.valueOf(),
);

// Full month names: en-AU's abbreviated forms are inconsistent across months
// ("Aug" but "July"), which reads as sloppy in a column of dates.
const fmt = new Intl.DateTimeFormat('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title="Gift Register | humAIn Media"
  description="A public record of gifts, hospitality and other benefits offered to the humAIn Media team."
  extraJsonLd={[crumbs]}
>
  <Nav />
  <main>
    <PageHeader
      secNum="— About"
      title="Gift register"
      lede="A public record of gifts, hospitality and other benefits offered to the humAIn Media team."
    />
    <div class="gift-page">
      <div class="wrap">
        <div class="gift-intro rv">
          <!-- Copy supplied by Cat — verbatim. Links are markup only, no rewording. -->
          <p>Our <a href="/about/editorial-standards">editorial standards</a> commit us to keeping this record.</p>
          <p>
            If you think something is missing from this register, tell us at
            <a href="mailto:admin@humain.au">admin@humain.au</a>.
          </p>
        </div>

        {
          entries.length === 0 ? (
            <div class="gift-empty rv">
              <p>No gifts or hospitality have been recorded yet.</p>
            </div>
          ) : (
            <div class="gift-table-wrap rv">
              <table class="gift-table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Gift</th>
                    <th>Offered by</th>
                    <th>Received by</th>
                    <th>Approx. value</th>
                    <th>Outcome</th>
                  </tr>
                </thead>
                <tbody>
                  {entries.map((e) => (
                    <tr>
                      <td data-label="Date">{fmt.format(e.data.dateReceived)}</td>
                      <td data-label="Gift">
                        {e.data.gift}
                        {e.data.notes ? <span class="gift-note">{e.data.notes}</span> : null}
                      </td>
                      <td data-label="Offered by">{e.data.from}</td>
                      <td data-label="Received by">{e.data.recipient}</td>
                      <td data-label="Approx. value">{e.data.estimatedValue ?? '—'}</td>
                      <td data-label="Outcome">
                        <span class="gift-outcome">{e.data.outcome}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .gift-page { padding: 48px 0 100px; }
  .gift-intro { max-width: 740px; margin-bottom: 40px; }
  .gift-intro p {
    font-size: 16px;
    line-height: 1.7;
    color: #fff;
    margin: 0 0 18px;
  }
  .gift-intro a { color: var(--pink); text-decoration: underline; }

  .gift-empty {
    border: 1px solid var(--line-2);
    border-radius: 12px;
    padding: 32px;
    max-width: 740px;
  }
  .gift-empty p {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  /* Wide table scrolls inside its own container rather than the page body. */
  .gift-table-wrap { overflow-x: auto; }
  .gift-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    min-width: 720px;
  }
  .gift-table th {
    text-align: left;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-2);
    font-weight: 500;
    padding: 0 16px 12px 0;
    border-bottom: 1px solid var(--line-2);
    white-space: nowrap;
  }
  .gift-table td {
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--line);
    color: #fff;
    line-height: 1.6;
    vertical-align: top;
  }
  .gift-note {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .gift-outcome {
    display: inline-block;
    padding: 3px 10px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 12px;
    white-space: nowrap;
  }

  /* Below the table's minimum width, each row becomes its own labelled card. */
  @media (max-width: 760px) {
    .gift-table, .gift-table tbody, .gift-table tr, .gift-table td { display: block; }
    .gift-table { min-width: 0; }
    .gift-table thead { display: none; }
    .gift-table tr {
      border: 1px solid var(--line-2);
      border-radius: 12px;
      padding: 8px 16px;
      margin-bottom: 14px;
    }
    .gift-table td {
      padding: 10px 0;
      border-bottom: 1px solid var(--line);
    }
    .gift-table tr td:last-child { border-bottom: none; }
    .gift-table td::before {
      content: attr(data-label);
      display: block;
      font-size: 11px;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--ink-2);
      margin-bottom: 4px;
    }
  }
</style>
