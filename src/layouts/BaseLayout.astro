---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { currentEdition } from '../utils/edition';
import { TICKET_URL, SITE } from '../config';
import { VENUE } from '../data/venue';
import TrackingPixels from '../components/TrackingPixels.astro';

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL of the OG image (defaults to /images/og-default.jpg) */
  ogImage?: string;
  /** Override canonical URL — defaults to the current page URL */
  canonical?: string;
  /** Article publish date for news pages */
  publishDate?: Date;
  /** Set true on pages that shouldn't be indexed (e.g. 404) */
  noindex?: boolean;
  /** Render Event + Organization JSON-LD — the principal event page only (homepage). */
  event?: boolean;
  /** Additional JSON-LD objects to emit (e.g. NewsArticle, BreadcrumbList). */
  extraJsonLd?: object[];
}

const {
  title = 'humAIn 2026 | AI, Marketing & Creativity Conference — Sydney, Australia',
  description = 'humAIn is Australia’s AI, marketing and creativity conference — 13–14 October 2026, Stone & Chalk Tech Central, Sydney. 250 senior marketing and creative leaders in one curated room.',
  ogImage = `${SITE}/images/og-default.jpg`,
  canonical = new URL(Astro.url.pathname, SITE).href,
  publishDate,
  noindex = false,
  event = false,
  extraJsonLd = [],
} = Astro.props;

const keynotes = event
  ? currentEdition(await getCollection('speakers')).filter((s) => s.data.keynote)
  : [];

const performer =
  keynotes.length > 0
    ? keynotes.map((s) => ({ '@type': 'Person', name: s.data.name, jobTitle: s.data.role }))
    : [{ '@type': 'Organization', name: 'humAIn', url: SITE }];

// Early-bird pricing ends 25 August 2026 (per Humanitix); builds after that
// date automatically emit standard pricing.
const EARLY_BIRD_ENDS = '2026-08-25';
const earlyBird = new Date() <= new Date(`${EARLY_BIRD_ENDS}T23:59:59+10:00`);

const ticketOffers = [
  { name: 'Conference only (Day 1)', early: '595', standard: '745' },
  { name: 'Conference + Workshop (both days)', early: '795', standard: '995' },
  { name: 'Workshop only (Day 2)', early: '475', standard: '595' },
].map((t) => ({
  '@type': 'Offer',
  name: earlyBird ? `${t.name} — early bird` : t.name,
  url: TICKET_URL,
  price: earlyBird ? t.early : t.standard,
  priceCurrency: 'AUD',
  availability: 'https://schema.org/InStock',
  validFrom: '2026-01-01',
  ...(earlyBird ? { priceValidUntil: EARLY_BIRD_ENDS } : {}),
}));

const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  '@id': `${SITE}/#event-2026`,
  name: 'humAIn 2026 — AI, Marketing & Creativity Conference',
  description:
    'humAIn is Australia’s AI, marketing and creativity conference, held 13–14 October 2026 at Stone & Chalk Tech Central, Sydney. Day one is a conference for 250 senior marketing, agency and creative leaders; day two is hands-on workshops capped at 100. Now independent, after three editions under the Mumbrella/Unmade banner.',
  startDate: '2026-10-13T09:00:00+11:00',
  endDate: '2026-10-14T17:00:00+11:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: VENUE,
  organizer: { '@type': 'Organization', name: 'humAIn', url: SITE, email: 'admin@humain.au' },
  performer,
  audience: {
    '@type': 'Audience',
    audienceType: 'CMOs, marketing leaders, agency executives and creative directors',
  },
  maximumAttendeeCapacity: 250,
  isAccessibleForFree: false,
  offers: ticketOffers,
  url: SITE,
  image: [ogImage],
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'humAIn',
  url: SITE,
  logo: `${SITE}/images/humAIn-transparent-logo.png`,
  description:
    'humAIn is a curated AI conference, media platform and community in Sydney for marketing and creative professionals.',
  publishingPrinciples: `${SITE}/about/editorial-standards/`,
  sameAs: [
    'https://www.facebook.com/61591295280884/',
    'https://www.instagram.com/humain_anz/',
    'https://www.linkedin.com/company/humain-media/',
  ],
};

const jsonLdBlocks = [...(event ? [eventJsonLd, organizationJsonLd] : []), ...extraJsonLd];
---

<!doctype html>
<html lang="en" class="pre">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={publishDate ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="humAIn" />
    <meta property="og:locale" content="en_AU" />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD structured data -->
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/humAIn-transparent-logo.png" />
    <link rel="apple-touch-icon" href="/images/humAIn-transparent-logo.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,500&family=Archivo+Expanded:wght@500;600;700;800;900&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KRBGN25HB2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KRBGN25HB2');
    </script>
  </head>
  <body>
    <TrackingPixels />
    <!-- shared SVG gradient referenced by all pulse-band instances -->
    <svg aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden">
      <defs>
        <linearGradient id="pgrad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1320" y2="0">
          <stop offset="0" stop-color="#F0379A" />
          <stop offset="0.28" stop-color="#F0531F" />
          <stop offset="0.5" stop-color="#FFC21A" />
          <stop offset="0.72" stop-color="#3D72F5" />
          <stop offset="1" stop-color="#19A85B" />
        </linearGradient>
      </defs>
    </svg>
    <slot />
    <script is:inline>
      /* ---- heartbeat / ECG generator ---- */
      function wavePath(w, H) {
        const U = 340,
          b = H * 0.55,
          a = H * 0.4;
        // logo silhouette: shoulder → subtle notch → tall W (peak, deep V, peak) → elevated plateau → descend
        const pat = [
          [0, 0],
          [0.13, -0.2],
          [0.18, -0.12],
          [0.225, -0.24],
          [0.3, -1.0],
          [0.39, 0.28],
          [0.48, -1.0],
          [0.57, -0.08],
          [0.64, -0.5],
          [0.86, -0.56],
          [1, 0],
        ];
        let d = '',
          first = true;
        for (let x0 = -U * 0.2; x0 < w + U; x0 += U) {
          for (let i = 0; i < pat.length; i++) {
            const x = x0 + pat[i][0] * U,
              y = b + pat[i][1] * a;
            if (first) {
              d += 'M' + x.toFixed(1) + ' ' + y.toFixed(1);
              first = false;
            } else d += 'L' + x.toFixed(1) + ' ' + y.toFixed(1);
          }
        }
        return d;
      }
      function buildPulses() {
        document.querySelectorAll('.pulse-band').forEach((band) => {
          const svg = band.querySelector('svg');
          const w = Math.max(band.clientWidth, 320);
          const H = +band.dataset.h || 120;
          svg.setAttribute('viewBox', '0 0 ' + w + ' ' + H);
          const d = wavePath(w, H);
          svg.querySelectorAll('path').forEach((p) => p.setAttribute('d', d));
          /* update shared gradient x2 to match width */
          const grad = document.getElementById('pgrad');
          if (grad) grad.setAttribute('x2', w);
        });
      }
      /* double-rAF ensures layout has settled before measuring clientWidth */
      requestAnimationFrame(() => requestAnimationFrame(buildPulses));
      addEventListener('load', buildPulses);
      let rt;
      addEventListener('resize', () => {
        clearTimeout(rt);
        rt = setTimeout(buildPulses, 150);
      });

      /* ---- reveal ---- */
      const rvs = [...document.querySelectorAll('.rv')];
      rvs.forEach((el, i) => {
        el.style.transitionDelay = Math.min(i % 3, 3) * 70 + 'ms';
      });
      let frames = 0,
        settled = false;
      function settle(animate) {
        if (settled) return;
        settled = true;
        if (!animate) {
          rvs.forEach((el) => {
            el.style.transition = 'none';
            el.style.opacity = '1';
            el.style.transform = 'none';
          });
          document.documentElement.classList.remove('pre');
          return;
        }
        const io = new IntersectionObserver(
          (es) => {
            es.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
        );
        rvs.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < innerHeight * 0.95) {
            el.classList.add('in');
          } else {
            io.observe(el);
          }
        });
      }
      function probe() {
        frames++;
        if (frames >= 4) {
          settle(true);
        } else {
          requestAnimationFrame(probe);
        }
      }
      requestAnimationFrame(probe);
      setTimeout(() => settle(false), 250);

      /* ---- lightbox ---- */
      (function () {
        const overlay = document.createElement('div');
        overlay.className = 'lb-overlay';
        overlay.setAttribute('aria-modal', 'true');
        overlay.setAttribute('role', 'dialog');
        overlay.setAttribute('aria-label', 'Image enlarged');
        const closeBtn = document.createElement('button');
        closeBtn.className = 'lb-close';
        closeBtn.innerHTML = '&times;';
        closeBtn.setAttribute('aria-label', 'Close');
        const lbImg = document.createElement('img');
        lbImg.alt = '';
        overlay.appendChild(closeBtn);
        overlay.appendChild(lbImg);
        document.body.appendChild(overlay);

        function open(tile) {
          const img = tile.querySelector('img');
          if (!img) return;
          lbImg.src = img.src;
          lbImg.alt = img.alt;
          overlay.classList.add('open');
          document.body.style.overflow = 'hidden';
        }
        function close() {
          overlay.classList.remove('open');
          document.body.style.overflow = '';
        }

        document.addEventListener('click', (e) => {
          const tile = e.target.closest('[data-lightbox]');
          if (tile) { open(tile); return; }
          if (overlay.classList.contains('open')) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
          if ((e.key === 'Enter' || e.key === ' ') && e.target.dataset.lightbox !== undefined) {
            e.preventDefault();
            open(e.target.closest('[data-lightbox]'));
          }
        });
      })();
    </script>
  </body>
</html>
