---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import PulseBand from '../components/PulseBand.astro';
import Tickets from '../components/Tickets.astro';
import { breadcrumbJsonLd } from '../utils/breadcrumbs';
import { currentEdition } from '../utils/edition';
import EarlyBirdNote from '../components/EarlyBirdNote.astro';
import { SITE, TICKET_URL, TICKET_IS_EXTERNAL } from '../config';
import { THEMES, themeById } from '../data/themes';

const crumbs = breadcrumbJsonLd([{ name: 'Programme', url: `${SITE}/programme/` }]);
const ticketTarget = TICKET_IS_EXTERNAL ? '_blank' : undefined;
const ticketRel = TICKET_IS_EXTERNAL ? 'noopener noreferrer' : undefined;

const sessions = currentEdition(await getCollection('schedule')).sort(
  (a, b) => a.data.order - b.data.order
);
const days = [
  { date: '2026-10-13', label: 'Day one', dateLabel: 'Tuesday 13 October 2026', sub: 'Main stage, round tables, closing debate' },
  { date: '2026-10-14', label: 'Day two', dateLabel: 'Wednesday 14 October 2026', sub: 'Workshops, 90 minutes each, capped rooms' },
] as const;
const sessionsByDay = days.map((d) => ({
  ...d,
  sessions: sessions.filter((s) => s.data.day === d.date),
}));
const hasAnySessions = sessions.length > 0;

// Only offer a theme as a filter if something is actually tagged with it —
// an empty filter is worse than a missing one.
const themesInUse = THEMES.map((t) => ({
  ...t,
  count: sessions.filter((s) => s.data.themes?.includes(t.id)).length,
})).filter((t) => t.count > 0);
---

<BaseLayout
  title="humAIn 2026 Programme | AI Marketing Conference, Sydney"
  description="Sydney, 13–14 October 2026. A two-day conference for senior marketing, media and creative leaders on turning AI into measurable growth and distinctive brands."
  extraJsonLd={[crumbs]}
>
  <Nav />
  <main>
    <PageHeader
      secNum="— Programme"
      h1="Programme"
      title="humAIn 2026: AI Marketing and Creativity Conference, Sydney"
      lede="13–14 October 2026, Sydney"
    />
    <PulseBand h={80} />

    {hasAnySessions && (
      <section style="padding-bottom:0">
        <div class="wrap">
          <div class="facts rv">
            <div class="fact">
              <div class="fact-n">{sessions.length}</div>
              <div class="fact-l">sessions announced, more to come</div>
            </div>
            <div class="fact">
              <div class="fact-n">{themesInUse.length}</div>
              <div class="fact-l">themes running across both days</div>
            </div>
            <div class="fact">
              <div class="fact-n">2</div>
              <div class="fact-l">days, main stage then workshops</div>
            </div>
            <div class="fact">
              <div class="fact-n">250</div>
              <div class="fact-l">marketing, media and creative leaders</div>
            </div>
          </div>
        </div>
      </section>
    )}

    {themesInUse.length > 0 && (
      <section id="themes">
        <div class="wrap">
          <div class="sec-head">
            <h2 class="rv">The big questions.</h2>
            <span class="sec-num">— The themes</span>
          </div>
          <p class="themes-intro rv">
            Themes are the spine, not the schedule. A session can sit in more than
            one. Pick a theme to filter the programme below.
          </p>
          <div class="prog-themes">
            {themesInUse.map((t) => (
              <button class="prog-theme rv" type="button" data-theme={t.id} aria-pressed="false">
                <div class="pt-num mono">Theme {t.num}</div>
                <h3>{t.name}</h3>
                <p>{t.hook}</p>
                <div class="pt-count">{t.count} session{t.count === 1 ? '' : 's'}</div>
              </button>
            ))}
          </div>
        </div>
      </section>
    )}

    <section id="sessions">
      <div class="wrap">
        <div class="sec-head">
          <h2 class="rv">The running order.</h2>
          <span class="sec-num">— Sessions</span>
        </div>
        {hasAnySessions ? (
          <>
            {themesInUse.length > 0 && (
              <div class="prog-filters rv" id="filters">
                <button class="chip" type="button" data-theme="" aria-pressed="true">All sessions</button>
                {themesInUse.map((t) => (
                  <button class="chip" type="button" data-theme={t.id} aria-pressed="false">{t.name}</button>
                ))}
                <span class="chip-count" id="filter-count" aria-live="polite"></span>
              </div>
            )}
            <div class="sched-days">
              {sessionsByDay.map((d) => d.sessions.length > 0 && (
                <div class="sched-day rv" data-day={d.date}>
                  <div class="sched-day-head">
                    <span class="sched-day-label mono">{d.label}</span>
                    <span class="sched-day-date">{d.dateLabel}</span>
                    <span class="sched-day-sub">{d.sub}</span>
                    <span class="sched-day-count mono" data-day-count></span>
                  </div>
                  <div class="sched-list">
                    {d.sessions.map((s) => (
                      <a class="sched-item" href={`/programme/${s.id}`} data-themes={(s.data.themes ?? []).join(' ')}>
                        <div class="sched-side">
                          {s.data.photos && s.data.photos.length > 0 && (
                            <div class="sched-photos">
                              {s.data.photos.map((photo) => (
                                <img
                                  class="sched-photo"
                                  src={photo}
                                  alt={s.data.speaker ?? s.data.title}
                                  width="140"
                                  height="140"
                                  loading="lazy"
                                />
                              ))}
                            </div>
                          )}
                          {s.data.format && <span class="sched-fmt mono">{s.data.format}</span>}
                          {s.data.startTime && (
                            <div class="sched-time mono">
                              {s.data.startTime}{s.data.endTime && <>–{s.data.endTime}</>}
                            </div>
                          )}
                        </div>
                        <div class="sched-body">
                          <div class="sched-top">
                            <h3>{s.data.title}</h3>
                            {s.data.stage && <span class="sched-stage">{s.data.stage}</span>}
                          </div>
                          {s.data.hook && <p class="sched-hook">{s.data.hook}</p>}
                          {s.data.speaker && <div class="sched-speaker">{s.data.speaker}</div>}
                        </div>
                        <div class="sched-tags">
                          {(s.data.themes ?? []).map((t) => (
                            <span class="sched-theme">{themeById(t)?.short ?? t}</span>
                          ))}
                          <span class="sched-more mono">Details →</span>
                        </div>
                      </a>
                    ))}
                  </div>
                  <p class="sched-none" hidden>No sessions in this theme on this day.</p>
                </div>
              ))}
            </div>
          </>
        ) : (
          <p class="sched-empty rv">
            The full session-by-session schedule is still being finalised. See the
            <a href="/voices">confirmed speakers</a> in the meantime — times and topics will appear here as they're locked in.
          </p>
        )}
      </div>
    </section>

    <section style="padding-top:0">
      <div class="wrap">
        <div class="prog-coming rv">
          <div class="prog-coming-inner">
            <h3>Turning AI adoption into real marketing advantage</h3>
            <p>
              AI is already embedded in marketing teams, workflows and technology stacks. The task now is turning all that activity into measurable growth; knowing where AI creates real advantage, and how human judgement, creativity and trust remain essential to making brands worth choosing.
            </p>
            <h3>AI search, brand visibility and the future of customer choice</h3>
            <p>
              The humAIn 2026 programme tackles the questions marketing, media and creative industry leaders are confronting in practice. How does brand visibility change when search, shopping and recommendation are mediated by AI, and by agents acting on the customer's behalf? How do you remain distinctive when every competitor can produce more content, faster and cheaper? Which parts of the marketing operation should be automated, augmented or kept deliberately human?
            </p>
            <h3>The future of marketing teams, creativity and work</h3>
            <p>
              The programme also examines what AI means for the economics of agencies, creative production and in-house teams; where judgement, taste and craft still earn their keep; and how the role of the CMO is changing.
            </p>
            <p>
              It takes on the future of work directly: how marketing roles are changing, which skills matter, and how the industry develops the talent it will need in 2030.
            </p>
            <h3>Synthetic media, AI influence and the future of brand trust</h3>
            <p>
              Trust is a central theme: how brands maintain credibility as synthetic content becomes ubiquitous, the role of artificial influencers and hyperfiction in entertainment, how audiences respond to AI influence, and whether authenticity can still create competitive advantage.
            </p>
            <h3>For the leaders shaping the future of AI in marketing</h3>
            <p>
              humAIn is built for the people making these calls: 250 marketing, media, agency and technology leaders in one room. You'll leave with a clearer view of the choices ahead, the trade-offs involved and how your peers are turning AI into meaningful results.
            </p>
            <div class="prog-coming-actions">
              <a href="/#contact" class="btn">Get in touch →</a>
              <a href="/voices" class="btn ghost">See the speakers →</a>
            </div>
          </div>
          <div class="prog-days">
            {sessionsByDay.map((d) => (
              <div class="prog-day rv">
                <div class="prog-day-label mono">{d.label}</div>
                <div class="prog-day-date">{d.dateLabel}</div>
                <div class="prog-day-theme">{d.sub}</div>
                {d.sessions.length > 0 ? (
                  <a href="#sessions" class="prog-day-tba prog-day-tba-link">
                    {d.sessions.length} session{d.sessions.length === 1 ? '' : 's'} announced →
                  </a>
                ) : (
                  <div class="prog-day-tba">Sessions to be announced</div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <Tickets />

    <section style="padding-top:0">
      <div class="wrap">
        <div class="sec-cta rv">
          <a href={TICKET_URL} class="btn" target={ticketTarget} rel={ticketRel}><span class="dot"></span>Get tickets →</a>
          <EarlyBirdNote />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Theme filter. Progressive enhancement only: every session is rendered and
  // visible in the HTML, and this script just hides the ones that don't match.
  // With JS off the page is the full programme, which is the correct fallback.
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.sched-item'));
  const controls = Array.from(document.querySelectorAll<HTMLElement>('[data-theme]'));
  const countEl = document.getElementById('filter-count');

  if (rows.length && controls.length) {
    let active: string | null = null;

    const apply = () => {
      for (const row of rows) {
        const themes = (row.dataset.themes ?? '').split(' ').filter(Boolean);
        row.hidden = active !== null && !themes.includes(active);
      }

      // Per-day counts, and the "no sessions in this theme" line for a day
      // that the active theme empties out entirely.
      for (const day of document.querySelectorAll<HTMLElement>('.sched-day')) {
        const shown = day.querySelectorAll('.sched-item:not([hidden])').length;
        const none = day.querySelector<HTMLElement>('.sched-none');
        if (none) none.hidden = shown > 0;
        const count = day.querySelector<HTMLElement>('[data-day-count]');
        if (count) count.textContent = `${shown} session${shown === 1 ? '' : 's'}`;
      }

      const total = document.querySelectorAll('.sched-item:not([hidden])').length;
      if (countEl) {
        countEl.textContent = active ? `Showing ${total} of ${rows.length}` : '';
      }

      for (const el of controls) {
        el.setAttribute('aria-pressed', String((el.dataset.theme || null) === active));
      }
    };

    for (const el of controls) {
      el.addEventListener('click', () => {
        const value = el.dataset.theme || null;
        // Clicking the active theme again clears the filter.
        active = value && value === active ? null : value;
        apply();
        if (el.classList.contains('prog-theme')) {
          document.getElementById('sessions')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    apply();
  }
</script>

<style>
  /* `hidden` has to beat the grid/flex display rules below, or filtered-out
     rows stay on screen. */
  [hidden] {
    display: none !important;
  }

  /* ---------- at a glance ---------- */
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
  }
  .fact {
    background: var(--panel);
    padding: 26px 24px;
  }
  .fact-n {
    font-family: var(--disp);
    font-weight: 800;
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }
  .fact-l {
    font-size: 13px;
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 22ch;
  }

  /* ---------- themes as filters ---------- */
  .themes-intro {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 58ch;
    margin: -24px 0 32px;
  }
  .prog-themes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .prog-theme {
    text-align: left;
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 18px;
    padding: 26px 24px;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    transition: 0.2s;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .prog-theme:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
  }
  .prog-theme[aria-pressed='true'] {
    border-color: var(--pink);
    box-shadow: inset 0 0 0 1px var(--pink);
  }
  .prog-theme:focus-visible {
    outline: 3px solid var(--pink);
    outline-offset: 3px;
  }
  .pt-num {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--pink);
  }
  .prog-theme h3 {
    font-family: var(--disp);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0;
  }
  .prog-theme p {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0;
  }
  .pt-count {
    margin-top: auto;
    padding-top: 12px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    border-top: 1px solid var(--line);
  }

  /* ---------- filter chips ---------- */
  .prog-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 40px;
  }
  .chip {
    background: transparent;
    border: 1px solid var(--line-2);
    color: var(--ink);
    border-radius: 100px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
  }
  .chip:hover {
    border-color: var(--ink);
  }
  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: #0b0908;
  }
  .chip:focus-visible {
    outline: 3px solid var(--pink);
    outline-offset: 3px;
  }
  .chip-count {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    margin-left: 6px;
  }

  /* ---------- sessions ---------- */
  .sched-days {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .sched-day + .sched-day {
    border-top: 1px solid var(--line-2);
    padding-top: 56px;
  }
  .sched-day-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-2);
  }
  .sched-day-label {
    color: var(--pink);
    font-size: 11px;
    letter-spacing: 0.14em;
  }
  .sched-day-date {
    font-family: var(--disp);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.01em;
  }
  .sched-day-sub {
    font-size: 13px;
    color: var(--ink-2);
  }
  .sched-day-count {
    margin-left: auto;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }
  .sched-list {
    display: flex;
    flex-direction: column;
  }
  .sched-item {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr) 150px;
    gap: 24px;
    padding: 32px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    transition: 0.2s;
  }
  .sched-item:first-child {
    padding-top: 0;
    border-top: none;
  }
  .sched-item:hover h3 {
    color: var(--pink);
  }
  .sched-item:hover .sched-more {
    color: var(--pink);
  }
  .sched-item:focus-visible {
    outline: 3px solid var(--pink);
    outline-offset: 4px;
  }
  .sched-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .sched-photos {
    display: flex;
    gap: 8px;
    width: 100%;
  }
  .sched-photo {
    flex: 1;
    min-width: 0;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 12px;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .sched-fmt {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px solid var(--line-2);
    border-radius: 100px;
    padding: 4px 10px;
  }
  .sched-time {
    color: var(--ink-2);
    font-size: 12px;
  }
  .sched-top {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .sched-body h3 {
    font-family: var(--disp);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
  }
  .sched-stage {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--yellow);
    white-space: nowrap;
  }
  .sched-hook {
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
    margin: 10px 0 0;
    max-width: 58ch;
  }
  .sched-speaker {
    font-size: 13px;
    color: var(--ink-2);
    margin-top: 8px;
  }
  .sched-more {
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-2);
    white-space: nowrap;
    transition: 0.2s;
  }
  .sched-tags {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }
  .sched-theme {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pink);
    border: 1px solid var(--line-2);
    border-radius: 100px;
    padding: 4px 10px;
    white-space: nowrap;
  }
  .sched-none {
    font-size: 14px;
    color: var(--ink-2);
    padding-top: 20px;
  }
  .sched-empty {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 56ch;
  }
  .sched-empty a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- long-form programme copy ---------- */
  .prog-coming {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    padding: 32px 0 100px;
    align-items: start;
  }
  .prog-coming p {
    font-size: 16px;
    line-height: 1.6;
    color: #fff;
    max-width: 52ch;
    margin-bottom: 16px;
  }
  .prog-coming-inner h3 {
    font-family: var(--disp);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 34px 0 12px;
  }
  .prog-coming-inner h3:first-child {
    margin-top: 0;
  }
  .prog-coming-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 36px;
  }
  .prog-days {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .prog-day {
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 18px;
    padding: 32px 30px;
  }
  .prog-day-label {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--pink);
    margin-bottom: 10px;
  }
  .prog-day-date {
    font-family: var(--disp);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }
  .prog-day-theme {
    font-size: 13px;
    color: var(--ink-2);
    margin-bottom: 20px;
  }
  .prog-day-tba {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    opacity: 0.5;
    text-transform: uppercase;
    border-top: 1px solid var(--line-2);
    padding-top: 16px;
  }
  .prog-day-tba-link {
    display: block;
    opacity: 1;
    color: var(--ink);
    text-decoration: none;
  }
  .prog-day-tba-link:hover {
    color: var(--pink);
  }

  @media (max-width: 1080px) {
    .prog-themes {
      grid-template-columns: repeat(2, 1fr);
    }
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 860px) {
    .prog-coming {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  @media (max-width: 720px) {
    .sched-item {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .sched-side {
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }
    .sched-photos {
      width: auto;
      max-width: 160px;
    }
    .sched-tags {
      flex-direction: row;
      align-items: flex-start;
      flex-wrap: wrap;
    }
  }
  @media (max-width: 560px) {
    .prog-themes,
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
