---
import { TICKET_URL, TICKET_IS_EXTERNAL } from '../config';

const ticketTarget = TICKET_IS_EXTERNAL ? '_blank' : undefined;
const ticketRel = TICKET_IS_EXTERNAL ? 'noopener noreferrer' : undefined;
---

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div>
        <div class="brand">
          <img src="/images/humAIn-transparent-logo.png" alt="humAIn" style="height:40px;width:auto" />
        </div>
        <p class="foot-tag">
          An AI media platform, conference and community for the people exploring what stays human
        </p>
        <div class="foot-social">
          <a href="https://www.instagram.com/humain_anz/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href="https://www.linkedin.com/company/humain-media/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
        </div>
      </div>
      <div class="foot-col">
        <h5>Event</h5><a href={TICKET_URL} target={ticketTarget} rel={ticketRel}>Tickets</a><a href="/#themes">Themes</a
        ><a href="/programme">Programme</a><a href="/voices">Speakers</a><a href="/gallery">Gallery</a>
      </div>
      <div class="foot-col">
        <h5>Media</h5><a href="/news">Articles</a><a href="/news/#podcast">Podcast</a><a href="/#newsletter">Newsletter</a>
      </div>
      <div class="foot-col">
        <h5>Company</h5><a href="/about">About</a><a href="/partners">Partners</a><a href="/#community">Community</a><a href="/#contact">Contact</a>
      </div>
    </div>
    <div class="foot-bot">
      <span>© 2026 humAIn. Built in public.</span>
      <div class="foot-legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms &amp; Conditions</a>
      </div>
    </div>
  </div>
</footer>
