# Keystatic GitHub-mode credentials.
#
# Easiest way to generate ALL of these: run `npm run dev` locally, open
# http://127.0.0.1:4321/keystatic and follow the one-time "Create GitHub App"
# onboarding — Keystatic creates the GitHub App on your account and writes the
# values into .env for you. Install the app on the `humain-site` repo when
# prompted.
#
# The same four values must then be added as environment variables on the host
# (Vercel project settings for now; Netlify after the Phase 9 migration).
# After the repo transfers to the owner's account (Phase 9), the GitHub App
# must be re-created/re-installed under her account and these values replaced.

# Contact form (Web3Forms — https://web3forms.com, free plan).
# Sign up with admin@humain.au, create an access key, and paste it here.
# Add the same value as WEB3FORMS_ACCESS_KEY in the Vercel project settings.
WEB3FORMS_ACCESS_KEY=

# From the GitHub App (Settings → Developer settings → GitHub Apps): the app's
# OAuth client ID and a generated client secret.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Random string used to sign Keystatic auth tokens. Generate with e.g.
# `openssl rand -hex 32` (the onboarding flow generates one for you).
KEYSTATIC_SECRET=

# The GitHub App's URL slug (the lowercased name in the app's public URL,
# https://github.com/apps/<slug>). Used to link users to the install page.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
