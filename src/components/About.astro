---
import EarlyBirdNote from './EarlyBirdNote.astro';
import { TICKET_URL, TICKET_IS_EXTERNAL } from '../config';

const ticketTarget = TICKET_IS_EXTERNAL ? '_blank' : undefined;
const ticketRel = TICKET_IS_EXTERNAL ? 'noopener noreferrer' : undefined;
---

<section id="about">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="rv">Two conversations,<br />one room.</h2>
      <span class="sec-num">01 — The premise</span>
    </div>
    <div class="two rv">
      <div>
        <div class="tag">The builders</div>
        <h3>How AI works</h3>
        <p>
          Models, tools, capabilities, speed. The people shipping the systems; what's actually possible this quarter,
          and what's still hype.
        </p>
      </div>
      <div>
        <div class="tag">The leaders</div>
        <h3>What AI means</h3>
        <p>
          For creativity, culture, jobs and decision-making. The marketers, creatives and leaders putting these systems
          to work in the real world.
        </p>
      </div>
    </div>
    <p class="merge rv">Most events pick a lane. humAIn brings them together.</p>
    <div class="sec-cta rv">
      <a href={TICKET_URL} class="btn" target={ticketTarget} rel={ticketRel}><span class="dot"></span>Get tickets →</a>
      <EarlyBirdNote />
    </div>
  </div>
</section>
