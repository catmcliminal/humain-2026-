---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import PulseBand from '../components/PulseBand.astro';
import TicketsProgramme from '../components/TicketsProgramme.astro';
import { breadcrumbJsonLd } from '../utils/breadcrumbs';
import { currentEdition } from '../utils/edition';
import { SITE } from '../config';
import { themeById } from '../data/themes';
import { DAYS } from '../data/days';
import { ROUND_TABLES } from '../data/roundtables';
import { UPFRONTS } from '../data/upfronts';
import { VENUE_LINE } from '../data/venue';

const crumbs = breadcrumbJsonLd([{ name: 'Programme', url: `${SITE}/programme/` }]);

const sessions = currentEdition(await getCollection('schedule')).sort(
  (a, b) => a.data.order - b.data.order
);
const days = DAYS;
const sessionsByDay = days.map((d) => ({
  ...d,
  sessions: sessions.filter((s) => s.data.day === d.date),
}));
const hasAnySessions = sessions.length > 0;
---

<BaseLayout
  title="humAIn 2026 Programme | AI Marketing Conference, Sydney"
  description="Sydney, 13–14 October 2026. A two-day conference for senior marketing, media and creative leaders on turning AI into measurable growth and distinctive brands."
  extraJsonLd={[crumbs]}
>
  <Nav />
  <main>
    <PageHeader
      secNum="— Programme"
      h1="Programme"
      title="humAIn 2026: AI Marketing and Creativity Conference, Sydney"
      lede="13–14 October 2026, Sydney"
    >
      <p class="prog-venue mono">{VENUE_LINE}</p>
    </PageHeader>
    <PulseBand h={80} />

    <section id="sessions">
      <div class="wrap">
        <div class="sec-head">
          <h2 class="rv">Sessions announced:</h2>
          <span class="sec-num">— Programme</span>
        </div>
        {hasAnySessions ? (
          <>
            <div class="sched-days">
              {sessionsByDay.map((d) => (
                <>
                {d.sessions.length > 0 && (
                <div class="sched-day rv">
                  <div class="sched-day-head">
                    <span class="sched-day-label mono">{d.label}</span>
                    <span class="sched-day-date">{d.dateLabel}</span>
                    <span class="sched-day-kind mono">{d.kind}</span>
                  </div>
                  <div class="sched-list">
                    {d.sessions.map((s) => (
                      <a class="sched-item" href={`/programme/${s.id}`}>
                        <div class="sched-side">
                          {s.data.photos && s.data.photos.length > 0 && (
                            <div class="sched-photos">
                              {s.data.photos.map((photo) => (
                                <img
                                  class="sched-photo"
                                  src={photo}
                                  alt={s.data.speaker ?? s.data.title}
                                  width="140"
                                  height="140"
                                  loading="lazy"
                                />
                              ))}
                            </div>
                          )}
                          {s.data.startTime && (
                            <div class="sched-time mono">
                              {s.data.startTime}{s.data.endTime && <>–{s.data.endTime}</>}
                            </div>
                          )}
                        </div>
                        <div class="sched-body">
                          <div class="sched-top">
                            <h3>{s.data.title}</h3>
                          </div>
                          {s.data.hook && <p class="sched-hook">{s.data.hook}</p>}
                          {s.data.speaker && <div class="sched-speaker">{s.data.speaker}</div>}
                        </div>
                        <div class="sched-tags">
                          {(s.data.themes ?? []).map((t) => (
                            <span class="sched-theme">{themeById(t)?.name ?? t}</span>
                          ))}
                          <span class="sched-cta mono">FULL SESSION →</span>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
                )}
                {/* The AI Upfronts are a day-one format of their own, so they
                    sit as a block after that day's sessions rather than mixed
                    into the main-stage list. */}
                {d.date === '2026-10-13' && (
                  <div class="rt-block rv" id="ai-upfronts">
                    <div class="sched-day-head">
                      <span class="sched-day-label mono">{d.label}</span>
                      <span class="sched-day-date">{d.dateLabel}</span>
                      <span class="sched-day-kind mono">AI Upfronts</span>
                    </div>
                    <div class="rt-grid">
                      {UPFRONTS.map((u) => (
                        <div class="rt-card">
                          {u.logo && (
                            <div class="uf-logo">
                              <img src={u.logo} alt={`${u.company} logo`} loading="lazy" />
                            </div>
                          )}
                          <div class="rt-topic mono">{u.company}</div>
                          <h5>{u.title}</h5>
                          {u.detail.map((para) => <p>{para}</p>)}
                          <p class="uf-speaker">{u.speaker}</p>
                          {u.url && (
                            <a class="uf-link" href={u.url} target="_blank" rel="noopener noreferrer">
                              Visit {u.company} →
                            </a>
                          )}
                        </div>
                      ))}
                    </div>
                  </div>
                )}
                {/* The round tables run at lunch on day one, so they belong
                    between the conference day and the workshop day — not after
                    both. Tied to the day rather than to a fixed position so a
                    day with no sessions yet doesn't take them down with it. */}
                {d.date === '2026-10-13' && (
                  <div class="rt-block rv" id="round-tables">
                    <div class="sched-day-head">
                      <span class="sched-day-label mono">{d.label}</span>
                      <span class="sched-day-date">{d.dateLabel}</span>
                      <span class="sched-day-kind mono">Round tables</span>
                    </div>
                    <p class="rt-note">Held under the Chatham House Rule.</p>
                    <div class="rt-grid">
                      {ROUND_TABLES.map((t) => (
                        <div class="rt-card">
                          <div class="rt-topic mono">{t.topic}</div>
                          <h5>{t.question}</h5>
                          {t.detail.map((para) => <p>{para}</p>)}
                        </div>
                      ))}
                    </div>
                  </div>
                )}
                </>
              ))}
            </div>
          </>
        ) : (
          <p class="sched-empty rv">
            The full session-by-session schedule is still being finalised. See the
            <a href="/voices">confirmed speakers</a> in the meantime — times and topics will appear here as they're locked in.
          </p>
        )}
      </div>
    </section>

    <section style="padding-top:0">
      <div class="wrap">
        <div class="prog-coming rv">
          <div class="prog-coming-inner">
            <h3>Turning AI adoption into real marketing advantage</h3>
            <p>
              AI is already embedded in marketing teams, workflows and technology stacks. The task now is turning all that activity into measurable growth; knowing where AI creates real advantage, and how human judgement, creativity and trust remain essential to making brands worth choosing.
            </p>
            <h3>AI search, brand visibility and the future of customer choice</h3>
            <p>
              The humAIn 2026 programme tackles the questions marketing, media and creative industry leaders are confronting in practice. How does brand visibility change when search, shopping and recommendation are mediated by AI, and by agents acting on the customer's behalf? How do you remain distinctive when every competitor can produce more content, faster and cheaper? Which parts of the marketing operation should be automated, augmented or kept deliberately human?
            </p>
            <h3>The future of marketing teams, creativity and work</h3>
            <p>
              The programme also examines what AI means for the economics of agencies, creative production and in-house teams; where judgement, taste and craft still earn their keep; and how the role of the CMO is changing.
            </p>
            <p>
              It takes on the future of work directly: how marketing roles are changing, which skills matter, and how the industry develops the talent it will need in 2030.
            </p>
            <h3>Synthetic media, AI influence and the future of brand trust</h3>
            <p>
              Trust is a central theme: how brands maintain credibility as synthetic content becomes ubiquitous, the role of artificial influencers and hyperfiction in entertainment, how audiences respond to AI influence, and whether authenticity can still create competitive advantage.
            </p>
            <h3>For the leaders shaping the future of AI in marketing</h3>
            <p>
              humAIn is built for the people making these calls: 250 marketing, media, agency and technology leaders in one room. You'll leave with a clearer view of the choices ahead, the trade-offs involved and how your peers are turning AI into meaningful results.
            </p>
            <div class="prog-coming-actions">
              <a href="/#contact" class="btn">Get in touch →</a>
              <a href="/voices" class="btn ghost">See the speakers →</a>
            </div>
          </div>
          <div class="prog-days">
            {sessionsByDay.map((d) => (
              <div class="prog-day rv">
                <div class="prog-day-label mono">{d.label}</div>
                <div class="prog-day-date">{d.dateLabel}</div>
                {d.sessions.length > 0 ? (
                  <a href="#sessions" class="prog-day-tba prog-day-tba-link">
                    {d.sessions.length} session{d.sessions.length === 1 ? '' : 's'} announced →
                  </a>
                ) : (
                  <div class="prog-day-tba">Sessions to be announced</div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Three tiers, each with its own CTA, so the generic "Get tickets" button
        that used to sit here would only repeat what the cards already offer. */}
    <TicketsProgramme />
  </main>
  <Footer />
</BaseLayout>


<style>
  /* `hidden` has to beat the grid/flex display rules below, or filtered-out
     rows stay on screen. */



  /* ---------- filter chips ---------- */

  /* ---------- sessions ---------- */
  .sched-days {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  /* Applies to whatever follows — the round tables sit between the two days,
     so day-to-day adjacency is no longer what draws the separator. */
  .sched-days > * + * {
    border-top: 1px solid var(--line-2);
    padding-top: 56px;
  }
  .sched-day-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-2);
  }
  .sched-day-label {
    color: var(--pink);
    font-size: 11px;
    letter-spacing: 0.14em;
  }
  .sched-day-date {
    font-family: var(--disp);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.01em;
  }
  /* "Conference" / "Workshops" — what the day is, next to its date. */
  .sched-day-kind {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-2);
    border: 1px solid var(--line-2);
    border-radius: 100px;
    padding: 4px 11px;
  }
  .sched-list {
    display: flex;
    flex-direction: column;
  }
  .sched-item {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr) 150px;
    gap: 24px;
    padding: 32px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    transition: 0.2s;
  }
  .sched-item:first-child {
    padding-top: 0;
    border-top: none;
  }
  .sched-item:hover h3 {
    color: var(--pink);
  }
  .sched-item:focus-visible {
    outline: 3px solid var(--pink);
    outline-offset: 4px;
  }
  .sched-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  /* A grid rather than a row, because a panel can have more than two faces:
     four across a 140px column would be 30px slivers, so they wrap two-up
     instead — one photo fills the column, any more sit in pairs. */
  .sched-photos {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    width: 100%;
  }
  .sched-photos:has(> :nth-child(2)) {
    grid-template-columns: 1fr 1fr;
  }
  .sched-photo {
    min-width: 0;
    width: 100%;
    /* The width/height="140" attributes (kept so the box is reserved before the
       image loads) map to CSS height, and an explicit height beats
       `aspect-ratio`. Without `height: auto` a two-speaker session renders
       66x140 slivers instead of squares. */
    height: auto;
    aspect-ratio: 1;
    border-radius: 12px;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .sched-time {
    color: var(--ink-2);
    font-size: 12px;
  }
  .sched-top {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .sched-body h3 {
    font-family: var(--disp);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
  }
  .sched-hook {
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
    margin: 10px 0 0;
    max-width: 58ch;
  }
  .sched-speaker {
    font-size: 13px;
    color: var(--ink-2);
    margin-top: 8px;
  }
  .sched-tags {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }
  .sched-cta {
    margin-top: 10px;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--ink);
    border: 1px solid var(--line-2);
    border-radius: 100px;
    padding: 7px 14px;
    white-space: nowrap;
    transition: 0.2s;
  }
  .sched-item:hover .sched-cta {
    background: var(--ink);
    border-color: var(--ink);
    color: #0b0908;
  }
  .sched-theme {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pink);
    border: 1px solid var(--line-2);
    border-radius: 100px;
    padding: 4px 10px;
    white-space: nowrap;
  }
  .sched-empty {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 56ch;
  }
  .sched-empty a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- long-form programme copy ---------- */
  .prog-coming {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    padding: 32px 0 100px;
    align-items: start;
  }
  .prog-coming p {
    font-size: 16px;
    line-height: 1.6;
    color: #fff;
    max-width: 52ch;
    margin-bottom: 16px;
  }
  .prog-coming-inner h3 {
    font-family: var(--disp);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 34px 0 12px;
  }
  .prog-coming-inner h3:first-child {
    margin-top: 0;
  }
  .prog-coming-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 36px;
  }
  .prog-days {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .prog-day {
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 18px;
    padding: 32px 30px;
  }
  .prog-day-label {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--pink);
    margin-bottom: 10px;
  }
  .prog-day-date {
    font-family: var(--disp);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }
  .prog-day-tba {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    opacity: 0.5;
    text-transform: uppercase;
    border-top: 1px solid var(--line-2);
    padding-top: 16px;
  }
  .prog-day-tba-link {
    display: block;
    opacity: 1;
    color: var(--ink);
    text-decoration: none;
  }
  .prog-day-tba-link:hover {
    color: var(--pink);
  }
  @media (max-width: 860px) {
    .prog-coming {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  @media (max-width: 720px) {
    .sched-item {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .sched-side {
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }
    .sched-photos {
      width: auto;
      max-width: 160px;
    }
    .sched-tags {
      flex-direction: row;
      align-items: flex-start;
      flex-wrap: wrap;
    }
  }

  /* ---------- round tables ---------- */
  /* The cards sit on dark, and these logos are drawn for light backgrounds,
     so each gets its own light chip rather than being recoloured. */
  .uf-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border-radius: 10px;
    padding: 10px 16px;
    margin-bottom: 14px;
    /* Fixed box: the logos load lazily, and without a reserved size the chip
       collapses to nothing and the card jumps when they arrive. */
    height: 62px;
    min-width: 130px;
  }
  /* Capped by height, not width, so logos of different proportions sit at the
     same optical weight rather than the same measure. */
  .uf-logo img {
    display: block;
    max-height: 40px;
    max-width: 158px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .uf-speaker {
    margin-top: 12px;
    font-weight: 600;
    color: var(--ink);
  }
  .uf-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 13px;
    color: var(--pink);
    text-decoration: underline;
  }
  .prog-venue {
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .rt-note {
    margin: -8px 0 24px;
    font-size: 14px;
    color: var(--ink-2);
  }
  /* Six tracks rather than fixed columns, so the last row can widen to fill
     itself. Five cards at three per row would otherwise leave a hole in row
     two; instead the last two take three tracks each and the row closes up.
     Written mobile-first so each breakpoint sets the span outright rather
     than fighting the one above it. The :has() guard means any other number
     of tables falls back to an even layout rather than an odd one. */
  .rt-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }
  .rt-card {
    grid-column: span 6;
  }
  /* Two per row, with a lone last card taking the full width. */
  @media (min-width: 721px) {
    .rt-card {
      grid-column: span 3;
    }
    .rt-grid > .rt-card:nth-child(odd):last-child {
      grid-column: span 6;
    }
  }
  /* Three per row; with exactly five, the last two share row two. */
  @media (min-width: 1081px) {
    .rt-card,
    .rt-grid > .rt-card:nth-child(odd):last-child {
      grid-column: span 2;
    }
    .rt-grid:has(> :nth-child(5):last-child) > .rt-card:nth-child(n + 4) {
      grid-column: span 3;
    }
  }
  .rt-card {
    border: 1px solid var(--line-2);
    border-radius: 18px;
    padding: 28px 26px 26px;
    display: flex;
    flex-direction: column;
  }
  .rt-topic {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--pink);
    margin-bottom: 14px;
  }
  .rt-card h5 {
    font-family: var(--disp);
    font-weight: 800;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: 14px;
    text-wrap: balance;
  }
  .rt-card p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .rt-card p + p {
    margin-top: 12px;
  }
  @media (max-width: 720px) {
    .rt-card {
      padding: 24px 22px;
    }
    .rt-card h5 {
      font-size: 21px;
    }
  }
</style>
