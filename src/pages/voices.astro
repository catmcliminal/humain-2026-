---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import SpeakerCard from '../components/SpeakerCard.astro';
import { currentEdition } from '../utils/edition';
import { breadcrumbJsonLd } from '../utils/breadcrumbs';
import { SITE } from '../config';

const crumbs = breadcrumbJsonLd([{ name: 'Voices', url: `${SITE}/voices/` }]);

// All speakers shown together, alphabetically by first name, with the same
// card treatment throughout.
//
// Sorted on the name itself, not on `order`. `order` was meant to encode this
// sequence, but every speaker added since was appended at the end, so the page
// ran A–V and then eight more out of order. Sorting here means a new entry
// lands in the right place with no renumbering. `order` still sets the
// sequence of the featured four on the homepage.
// A leading title is ignored when sorting, so "Dr Patrick Aouad" files under
// P with the other Patricks while still displaying in full.
const HONORIFIC = /^(?:dr|prof|professor|mr|mrs|ms|mx)\.?\s+/i;
const sortKey = (name: string) => name.replace(HONORIFIC, '');

const all = currentEdition(await getCollection('speakers')).sort((a, b) =>
  sortKey(a.data.name).localeCompare(sortKey(b.data.name), 'en', { sensitivity: 'base' })
);
---

<BaseLayout
  title="Speakers — humAIn 2026 | AI Marketing Conference, Sydney"
  description="Meet the speakers at humAIn 2026 — builders, founders, leaders and critics taking the stage in Sydney, 13–14 October 2026."
  extraJsonLd={[crumbs]}
>
  <Nav />
  <main>
    <PageHeader
      secNum="05 — Speakers"
      title="The full&nbsp;lineup."
      lede="Every speaker taking the humAIn stage — marketers, builders, founders, leaders, creatives and critics. More to be announced."
    />
    <section style="padding-top:48px">
      <div class="wrap">
        <div class="voices">
          {all.map((s) => <SpeakerCard speaker={s} showBio />)}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
