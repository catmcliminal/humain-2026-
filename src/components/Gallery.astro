---
import { getCollection } from 'astro:content';

// The Pulse design is a 7-tile bento grid (g-a … g-g, each a fixed span).
// We map gallery entries onto those layout slots in `order`; if an editor adds
// more than seven images the layout classes cycle so the grid still tiles.
const tileClasses = ['g-a', 'g-b', 'g-c', 'g-d', 'g-e', 'g-f', 'g-g'];

const images = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
---

<section id="gallery" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="rv">Scenes from the floor.</h2>
      <span class="sec-num">06 — Gallery</span>
    </div>
    <div class="gal rv">
      {
        images.map((img, i) => (
          <div class={`gtile ${tileClasses[i % tileClasses.length]}`}>
            {img.data.caption && <span class="cap">{img.data.caption}</span>}
            <img src={img.data.image} alt={img.data.alt} loading="lazy" />
          </div>
        ))
      }
    </div>
    <div style="margin-top:26px"><a href="#" class="btn ghost">See the full gallery →</a></div>
  </div>
</section>
