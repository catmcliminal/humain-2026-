---
import { TICKET_URL, TICKET_IS_EXTERNAL } from '../config';

const ticketTarget = TICKET_IS_EXTERNAL ? '_blank' : undefined;
const ticketRel = TICKET_IS_EXTERNAL ? 'noopener noreferrer' : undefined;

const tiers = [
  {
    name: 'Conference only',
    desc: 'Day one only',
    earlyPrice: '$595',
    standardPrice: '$745',
    saving: '$150',
    featured: false,
  },
  {
    name: 'Conference + Workshop',
    desc: 'Both days',
    earlyPrice: '$795',
    standardPrice: '$995',
    saving: '$200',
    featured: true,
  },
  {
    name: 'Workshop only',
    desc: 'Day two only',
    earlyPrice: '$475',
    standardPrice: '$595',
    saving: '$120',
    featured: false,
  },
];
---

<section id="conference">
  <div class="wrap">
    <div class="conf">
      <div class="conf-in">
        <div class="conf-left">
          <div class="kik">▶ The flagship event</div>
          <h2>humAIn<br />2026</h2>
          <div class="conf-meta">
            <div class="m"><b>13–14 Oct</b><span>Two days</span></div>
            <div class="m"><b>Sydney</b><span>CBD · AUSTRALIA</span></div>
            <div class="m"><b>40+ voices</b><span>BUILDERS &amp; LEADERS</span></div>
            <div class="m"><b>250+ delegates</b><span>SENIOR MARKETERS &amp; CREATIVES</span></div>
          </div>
          <p>
            Two days of talks, debate: thinking out loud and building in public; connecting the people making AI with
            the people making meaning with it.
          </p>
        </div>
        <div class="conf-right" role="list" aria-label="Ticket options">
          {tiers.map((t) => (
            <div class:list={['tier', { feat: t.featured }]} role="listitem" aria-label={t.featured ? `${t.name} — recommended` : t.name}>
              <div>
                <div class="tn">{t.name}</div>
                <div class="td">{t.desc}</div>
              </div>
              <div class="tier-pricing">
                <div class="tp">{t.earlyPrice} <span class="tp-gst">+ gst</span></div>
                <div class="tp-save">Save {t.saving} · Early bird</div>
                <div class="tp-standard">Standard {t.standardPrice} + gst</div>
              </div>
              <a
                href={TICKET_URL}
                class="btn tier-btn"
                target={ticketTarget}
                rel={ticketRel}
                aria-label={`Register for ${t.name} — ${t.earlyPrice} + gst`}
              >Register now <span aria-hidden="true">→</span></a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tier {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 4px 12px;
    align-items: start;
  }
  .tier-pricing {
    text-align: right;
  }
  .tp-gst {
    font-size: 0.7em;
    opacity: 0.7;
  }
  .tp-save {
    font-size: 0.75em;
    color: var(--green);
    margin-top: 2px;
  }
  .tp-standard {
    font-size: 0.7em;
    opacity: 0.65;
    margin-top: 1px;
  }
  .tier-btn {
    grid-column: 1 / -1;
    justify-content: center;
    margin-top: 6px;
  }
  .feat .tier-btn {
    background: #fff;
    color: #0b0908;
    border-color: #fff;
  }
  .feat .tier-btn:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: #0b0908;
  }
  .feat .tp-save {
    color: #fff;
    font-weight: 700;
  }
  .feat .tp-standard {
    color: rgba(255,255,255,0.75);
    opacity: 1;
  }
</style>
