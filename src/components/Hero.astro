---
import PulseBand from './PulseBand.astro';
import EarlyBirdNote from './EarlyBirdNote.astro';
import { TICKET_URL, TICKET_IS_EXTERNAL } from '../config';

const ticketTarget = TICKET_IS_EXTERNAL ? '_blank' : undefined;
const ticketRel = TICKET_IS_EXTERNAL ? 'noopener noreferrer' : undefined;

const featuredSpeakerCompanies = [
  { name: 'Unilever', logo: '/images/logos/Unilever.svg' },
  { name: 'Amazon', logo: '/images/logos/Amazon.svg' },
  { name: 'Uber', logo: '/images/logos/Uber.svg' },
  { name: 'Mutinex', logo: '/images/logos/Mutinex.svg' },
  { name: 'Zambrero', logo: '/images/logos/Zambrero.png' },
  { name: 'RGA', logo: '/images/logos/RGA.png' },
];
---

<header class="hero">
  <div class="wrap">
    <div class="eyebrow mono"><span class="tk"></span>humAIn 2026 · The human signal in the age of AI</div>
    <h1 class="hero-h rv">What remains<br />irreducibly <em>human</em><br />in the AI era.</h1>
    <div class="hero-grid">
      <div class="rv">
        <p class="hero-sub">
          AI can generate content, analyse information and automate decisions. What it cannot replace is
          <b>human judgement, taste, responsibility and meaning.</b>
          <br /><br />
          Make AI work. Make the work matter.
          <br /><br />
          Two days for marketing, media and creative leaders to build practical AI skills, sharpen their
          judgement, and make informed decisions about brands, teams and growth.
        </p>
        <div class="hero-days">
          <div class="hero-day">
            <div class="hero-day-meta mono">13 October · Single-stream conference</div>
            <p>
              <b>Day one:</b> Case studies, demos, debate, and round tables for marketing, media and creative leaders
              to sharpen their judgement, exchange knowledge with peers, and make more informed decisions about brands,
              teams and growth.
            </p>
          </div>
          <div class="hero-day">
            <div class="hero-day-meta mono">14 October · Select your workshops</div>
            <p><b>Day two:</b> Build practical AI skills through masterclasses and workshops (limited places).</p>
          </div>
        </div>
        <div class="hero-cta">
          <a href={TICKET_URL} class="btn" target={ticketTarget} rel={ticketRel}
            ><span class="dot"></span>Get tickets</a
          >
          <a href="/programme" class="btn ghost">Explore the programme →</a>
          <EarlyBirdNote />
        </div>
      </div>
      <div class="hero-mark rv">
        <img src="/images/humain-waveform-v2.png" alt="humAIn 2026 AI conference, Sydney" width="1016" height="456" />
      </div>
    </div>
  </div>
  <PulseBand class="hero-pulse" h={150} />
  <div class="featured-speakers">
    <div class="wrap">
      <span class="featured-speakers-label mono">Featured speakers from</span>
      <div class="featured-speakers-logos">
        {
          featuredSpeakerCompanies.map((c) => (
            <div class="featured-speakers-logo" title={c.name}>
              <img src={c.logo} alt={`${c.name} logo`} loading="lazy" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="strip">
    <div class="ticker">
      <span>AI &amp; Creative Work</span><span>The Taste Gap</span><span>Brand Discovery in the AI Age</span><span
        >Culture as Training Data</span
      ><span>Building in Public</span><span>Debate &amp; Dissent</span>
      <span>AI &amp; Creative Work</span><span>The Taste Gap</span><span>Brand Discovery in the AI Age</span><span
        >Culture as Training Data</span
      ><span>Building in Public</span><span>Debate &amp; Dissent</span>
    </div>
  </div>
</header>

<style>
  .hero-days {
    max-width: 46ch;
    margin-top: 26px;
    display: grid;
    gap: 18px;
  }
  .hero-day {
    border-left: 2px solid var(--line-2);
    padding-left: 14px;
  }
  .hero-day:first-child {
    border-left-color: var(--pink);
  }
  .hero-day-meta {
    color: var(--ink-2);
    margin-bottom: 6px;
  }
  .hero-day p {
    font-size: 17px;
    line-height: 1.5;
    color: #fff;
  }
  .hero-day b {
    font-weight: 700;
  }

  .featured-speakers {
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }

  .featured-speakers-label {
    display: block;
    text-align: center;
    color: var(--ink-2);
    margin-bottom: 18px;
  }

  .featured-speakers-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .featured-speakers-logo {
    background: #fff;
    border-radius: 10px;
    height: 44px;
    padding: 9px 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .featured-speakers-logo img {
    height: 100%;
    width: auto;
    max-width: 120px;
    object-fit: contain;
  }

  @media (max-width: 700px) {
    .featured-speakers-logo {
      height: 34px;
      padding: 7px 14px;
    }
  }
</style>
