---
/**
 * Countdown to the conference opening, shown in the hero above the pulse line.
 * Four progress rings (days, hours, minutes, seconds) drawn with the brand
 * colours. Dates live in `src/config.ts`. Hidden after the event ends.
 */
import { EVENT_START, EVENT_END } from '../config';

const units = [
  { key: 'days', label: 'Days', from: '#F0379A', to: '#F0531F' },
  { key: 'hours', label: 'Hours', from: '#FFC21A', to: '#19A85B' },
  { key: 'mins', label: 'Mins', from: '#3D72F5', to: '#F0379A' },
  { key: 'secs', label: 'Secs', from: '#F0531F', to: '#FFC21A' },
];
const R = 52;
const C = 2 * Math.PI * R;
---

<section class="countdown" data-start={EVENT_START} data-end={EVENT_END} aria-label="Countdown to humAIn 2026" hidden>
  <div class="wrap">
    <p class="cd-eyebrow mono"><span class="tk"></span><span class="cd-status">Doors open 13 October · Sydney</span></p>
    <div class="cd-rings" role="timer">
      {
        units.map((u) => (
          <div class="cd-unit" data-unit={u.key}>
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <defs>
                <linearGradient id={`cdg-${u.key}`} x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color={u.from} />
                  <stop offset="1" stop-color={u.to} />
                </linearGradient>
              </defs>
              <circle class="cd-track" cx="60" cy="60" r={R} />
              <circle
                class="cd-arc"
                cx="60"
                cy="60"
                r={R}
                stroke={`url(#cdg-${u.key})`}
                stroke-dasharray={C}
                stroke-dashoffset={C}
                transform="rotate(-90 60 60)"
              />
              <path class="cd-arrow" d="M60 1 L66 8 L54 8 Z" fill={u.from} />
            </svg>
            <div class="cd-text">
              <b class="cd-num" data-num>0</b>
              <span class="cd-label mono">{u.label}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<noscript>
  <style>
    .countdown {
      display: block !important;
    }
    .cd-rings {
      display: none;
    }
  </style>
</noscript>

<script is:inline define:vars={{ C }}>
  (function () {
    var el = document.querySelector('.countdown');
    if (!el) return;
    var start = Date.parse(el.dataset.start);
    var end = Date.parse(el.dataset.end);
    var status = el.querySelector('.cd-status');
    var rings = el.querySelector('.cd-rings');
    var units = {};
    ['days', 'hours', 'mins', 'secs'].forEach(function (k) {
      var u = el.querySelector('[data-unit="' + k + '"]');
      units[k] = { num: u.querySelector('[data-num]'), arc: u.querySelector('.cd-arc') };
    });
    var span = { days: 100, hours: 24, mins: 60, secs: 60 };
    function set(k, v) {
      var t = units[k];
      var s = String(v);
      if (t.num.textContent !== s) t.num.textContent = s;
      t.arc.style.strokeDashoffset = C * (1 - Math.min(v / span[k], 1));
    }
    function tick() {
      var now = Date.now();
      if (now >= end) {
        el.hidden = true;
        return false;
      }
      el.hidden = false;
      if (now >= start) {
        rings.hidden = true;
        status.textContent = 'humAIn 2026 is on now · Sydney';
        return true;
      }
      var d = Math.floor((start - now) / 1000);
      set('days', Math.floor(d / 86400));
      set('hours', Math.floor((d % 86400) / 3600));
      set('mins', Math.floor((d % 3600) / 60));
      set('secs', d % 60);
      return true;
    }
    if (tick()) setInterval(tick, 1000);
  })();
</script>

<style>
  .countdown {
    padding: 34px 0 6px;
    text-align: center;
  }
  .countdown[hidden] {
    display: none;
  }
  .cd-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-2);
    margin: 0 0 22px;
  }
  .cd-eyebrow .tk {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 10px var(--pink);
    animation: pulse 1.6s infinite;
  }
  .cd-rings {
    display: flex;
    justify-content: center;
    gap: clamp(14px, 4vw, 44px);
  }
  .cd-unit {
    position: relative;
    width: clamp(70px, 18vw, 132px);
    aspect-ratio: 1;
  }
  .cd-unit svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .cd-track {
    fill: none;
    stroke: var(--line);
    stroke-width: 7;
  }
  .cd-arc {
    fill: none;
    stroke-width: 7;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.9s linear;
    filter: drop-shadow(0 0 6px rgba(240, 55, 154, 0.35));
  }
  .cd-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }
  .cd-num {
    font-family: var(--disp);
    font-weight: 800;
    font-size: clamp(22px, 5.2vw, 40px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }
  .cd-label {
    font-size: clamp(8px, 1.8vw, 11px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .cd-eyebrow .tk {
      animation: none;
    }
    .cd-arc {
      transition: none;
    }
  }
</style>
