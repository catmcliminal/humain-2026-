---
/**
 * Static placeholder matching the empty-state look of the interactive
 * <image-slot> mockup element in the source design. Replaced with real
 * images from content collections in Phase 4.
 */
interface Props {
  id?: string;
  placeholder?: string;
}

const { id, placeholder = 'Drop an image' } = Astro.props;
---

<image-slot id={id}>
  <span class="is-frame"></span>
  <span class="is-empty">
    <svg
      width="28"
      height="28"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
      <circle cx="8.5" cy="8.5" r="1.5"></circle>
      <path d="m21 15-5-5L5 21"></path>
    </svg>
    <span class="is-cap">{placeholder}</span>
  </span>
  <span class="is-ring"></span>
</image-slot>
