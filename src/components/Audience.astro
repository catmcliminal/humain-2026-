---
import { TICKET_URL, TICKET_IS_EXTERNAL } from '../config';

const ticketTarget = TICKET_IS_EXTERNAL ? '_blank' : undefined;
const ticketRel = TICKET_IS_EXTERNAL ? 'noopener noreferrer' : undefined;
---

<section id="audience" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="rv">Who humAIn is for.</h2>
      <span class="sec-num">02 — The room</span>
    </div>
    <div class="aud">
      <div class="a rv" style="--ac:var(--pink)">
        <div class="ico">M</div>
        <h3>CMOs &amp; marketing leaders</h3>
        <p>
          Using AI in brand &amp; growth — navigating content velocity, AI search and what earns trust when machines
          mediate discovery.
        </p>
        <div class="ft">In-house · Brand · Growth</div>
      </div>
      <div class="a rv" style="--ac:var(--blue)">
        <div class="ico">F</div>
        <h3>Founders &amp; builders</h3>
        <p>
          Building AI products &amp; startups who want the cultural context and the hard questions, not just the next
          changelog.
        </p>
        <div class="ft">Startups · Product · Engineering</div>
      </div>
      <div class="a rv" style="--ac:var(--orange)">
        <div class="ico">R</div>
        <h3>Researchers</h3>
        <p>
          Exploring AI &amp; culture — operators and thinkers who need judgment and perspective more than another hype
          cycle.
        </p>
        <div class="ft">Research · Academia · Policy</div>
      </div>
      <div class="a rv" style="--ac:var(--green)">
        <div class="ico">C</div>
        <h3>Creative directors &amp; strategists</h3>
        <p>
          Working with generative AI — designers, directors and strategists navigating craft and authorship when
          generation is effectively free.
        </p>
        <div class="ft">Studios · Agencies · Independents</div>
      </div>
    </div>

    <div class="aud-stats rv">
      <div class="aud-stat-label">Past delegates</div>
      <div class="aud-stats-grid">
        <div class="aud-stat">
          <span class="aud-stat-num">24%</span>
          <span class="aud-stat-desc">CMO + marketing directors</span>
        </div>
        <div class="aud-stat">
          <span class="aud-stat-num">17%</span>
          <span class="aud-stat-desc">Founders + Builders</span>
        </div>
        <div class="aud-stat">
          <span class="aud-stat-num">35%</span>
          <span class="aud-stat-desc">Senior creatives, strategists and agency leaders</span>
        </div>
        <div class="aud-stat">
          <span class="aud-stat-num">81%</span>
          <span class="aud-stat-desc">Decision-makers in the room</span>
        </div>
      </div>
    </div>

    <div class="prev-attendees rv">
      <div class="prev-attendees-label">Previous attendees</div>
      <div class="prev-attendees-grid">
        {[
          ['Adobe','Adobe'],['Afterpay / Block','Afterpay_Block'],['ALDI','ALDI'],
          ['ANZ','ANZ'],['Arriba Group','Arriba_Group'],['Asahi Beverages','Asahi_Beverages'],
          ['ABC','Australian_Broadcasting_Corporation'],['ACAM','Australian_Centre_for_AI_in_Marketing'],
          ['Australian Radio Network','Australian_Radio_Network'],['Auto & General','Auto_and_General'],
          ['Bank of Queensland','Bank_of_Queensland_Group'],['Big W','Big_W'],
          ['Budget Direct','Budget_Direct'],['Cancer Council','Cancer_Council'],
          ['Canva','Canva'],['Capgemini','Capgemini'],['Coles','Coles'],
          ['dentsu','dentsu'],['Doohly','Doohly'],['Envato','Envato'],
          ['Finder','Finder'],['Foxtel','FOXTEL'],['FutureBrand','FutureBrand'],
          ['Kayo Sport','Kayo_Sport'],['KPMG Australia','KPMG_Australia'],
          ['Leonardo.Ai','Leonardo_Ai'],['Lion','Lion'],['Microsoft','Microsoft'],
          ['Nine','Nine'],['oOh!media','Ooh_media'],['Optus','Optus'],
          ['Samsung','Samsung'],['SBS','SBS'],['Westfield','Westfield'],
          ['Southern Cross Austereo','Southern_Cross_Austereo'],['Springboards','Springboards'],
          ['TBWA Melbourne','TBWA_Melbourne'],['Thinkerbell','Thinkerbell'],
          ['Virgin Australia','Virgin_Australia_Velocity'],['Weatherzone','Weatherzone'],
        ].map(([name, file]) => (
          <div class="pa-logo" title={name}>
            <img
              src={`/images/logos/${file}.png`}
              alt={name}
              width="32"
              height="32"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>

    <div class="sec-cta rv">
      <a href={TICKET_URL} class="btn" target={ticketTarget} rel={ticketRel}><span class="dot"></span>Get tickets →</a>
    </div>
  </div>
</section>

<style>
  .prev-attendees { margin-top: 40px; }
  .prev-attendees-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 20px;
  }
  .prev-attendees-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .pa-logo {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid rgba(250,247,241,.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  .pa-logo img { display: block; }
</style>
