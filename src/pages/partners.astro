---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { breadcrumbJsonLd } from '../utils/breadcrumbs';
import { SITE } from '../config';
import { partners, associations } from '../utils/partners';

const crumbs = breadcrumbJsonLd([{ name: 'Partners', url: `${SITE}/partners/` }]);
---

<BaseLayout
  title="Partners — humAIn 2026 | AI Marketing Conference, Sydney"
  description="The organisations partnering with humAIn 2026 — Sydney's conference for marketing and creative leaders navigating AI."
  extraJsonLd={[crumbs]}
>
  <Nav />
  <main>
    <PageHeader
      secNum="— Partners"
      title="Reach the room shaping&nbsp;AI in marketing and&nbsp;creativity."
      lede="humAIn is Australia's curated conference for the marketers, founders, creatives and technologists leading the AI conversation, deciding how AI gets used, and what stays human."
    >
      <a class="btn head-cta rv" href="#become-a-partner">
        <span class="dot"></span>Become a partner
      </a>
    </PageHeader>
    <section style="padding-top:48px;padding-bottom:96px">
      <div class="wrap">
        {[
          { heading: 'Thanks to our partners.', secNum: null, items: partners },
          { heading: 'Supporting associations', secNum: '— Associations', items: associations },
        ].map((group, i) => group.items.length > 0 && (
          <>
            {group.heading && (
              <div class:list={['sec-head', 'group-head', i > 0 && 'group-head-sep']}>
                <h2 class="rv">{group.heading}</h2>
                {group.secNum && <span class="sec-num">{group.secNum}</span>}
              </div>
            )}
            <div class="partners-list">
              {group.items.map((p) => (
                <div class="partner-card rv" style={`--ac:${p.accent}`}>
                  <div class="partner-logo">
                    <img src={p.logo} alt={`${p.name} logo`} loading="lazy" />
                  </div>
                  <div class="partner-body">
                    <span class="partner-role">{p.role}</span>
                    <h2>{p.name}</h2>
                    {p.copy.split('\n\n').map((para) => <p>{para}</p>)}
                    {p.url && (
                      <a class="partner-link" href={p.url} target="_blank" rel="noopener">
                        Visit {p.name} →
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </>
        ))}
      </div>
    </section>

    <section style="padding-top:0;padding-bottom:96px">
      <div class="wrap">
        <div class="sec-head">
          <h2 class="rv">What a humAIn partnership gives you.</h2>
          <span class="sec-num">— Why partner</span>
        </div>
        <div class="themes">
          <div class="theme t1 rv">
            <div class="tnum">01</div>
            <div>
              <h3>Proximity to decision-makers</h3>
              <p>A room where 89% are manager level or above. You sit beside the people setting AI strategy, not the ones still googling it.</p>
            </div>
          </div>
          <div class="theme t2 rv">
            <div class="tnum">02</div>
            <div>
              <h3>Authority by association</h3>
              <p>Align with a serious, independent conversation about AI and creativity. The kind of thought leadership and credibility a banner can't buy.</p>
            </div>
          </div>
          <div class="theme t3 rv">
            <div class="tnum">03</div>
            <div>
              <h3>Engagement that lasts</h3>
              <p>One room, one day. Conversations that carry on long after the close.</p>
            </div>
          </div>
          <div class="theme t4 rv">
            <div class="tnum">04</div>
            <div>
              <h3>A presence between events</h3>
              <p>A database growing ~20% a year, plus newsletter, content and a podcast that keep you in the room year-round.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="become-a-partner" style="padding-top:0;padding-bottom:96px">
      <div class="wrap">
        <div class="contact-cta rv">
          <div class="cc-photo">
            <img src="/images/team/denise-fletcher.jpg" alt="Denise Fletcher" loading="lazy" />
          </div>
          <div class="cc-body">
            <p class="cc-lede">Get in touch to explore opportunities to showcase your thought leadership to a grown up and highly engaged audience.</p>
            <div class="cc-contact">
              <span class="cc-name">Denise Fletcher</span>
              <span class="cc-role">Head of Partnerships</span>
            </div>
            <div class="cc-form" id="partners-contact-form">
              <div class="cf-row">
                <div class="cf-field">
                  <label for="cc-name">Name</label>
                  <input id="cc-name" type="text" name="name" placeholder="Your name" />
                </div>
                <div class="cf-field">
                  <label for="cc-email">Email</label>
                  <input id="cc-email" type="email" name="email" placeholder="your@email.com" />
                </div>
              </div>
              <div class="cf-field">
                <label for="cc-message">Message</label>
                <textarea id="cc-message" name="message" rows="4" placeholder="Tell us about your organisation and what you're looking for…"></textarea>
              </div>
              <a id="cc-mailto" class="btn cf-submit" href="mailto:admin@humain.au,denise@humain.au">Email Denise →</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const mailLink = document.getElementById('cc-mailto') as HTMLAnchorElement | null;
  mailLink?.addEventListener('click', () => {
    const name = (document.getElementById('cc-name') as HTMLInputElement | null)?.value ?? '';
    const email = (document.getElementById('cc-email') as HTMLInputElement | null)?.value ?? '';
    const message = (document.getElementById('cc-message') as HTMLTextAreaElement | null)?.value ?? '';
    const body = `Name: ${name}\nEmail: ${email}\n\n${message}`;
    mailLink.href = `mailto:admin@humain.au,denise@humain.au?subject=${encodeURIComponent('Partnership enquiry')}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .partners-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .head-cta {
    margin-top: 28px;
  }
  /* Clear the sticky nav so the CTA target isn't tucked underneath it. */
  #become-a-partner {
    scroll-margin-top: 90px;
  }
  .group-head-sep {
    margin-top: 64px;
  }
  .partner-card {
    position: relative;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 36px;
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 16px;
    padding: 40px;
    overflow: hidden;
  }
  .partner-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--ac);
  }
  .partner-logo {
    width: 200px;
    height: 200px;
    border-radius: 14px;
    background: #fff;
    border: 1px solid rgba(250, 247, 241, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  .partner-logo img {
    width: 78%;
    height: 78%;
    object-fit: contain;
  }
  .partner-role {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ac);
    margin-bottom: 8px;
  }
  .partner-body h2 {
    font-family: var(--disp);
    font-weight: 800;
    font-size: 32px;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
  }
  .partner-body p {
    font-size: 15px;
    line-height: 1.65;
    color: #fff;
    margin: 0 0 14px;
  }
  .partner-body p:last-child {
    margin-bottom: 0;
  }
  .partner-link {
    display: inline-block;
    margin-top: 18px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ac);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .partner-link:hover {
    border-bottom-color: var(--ac);
  }

  @media (max-width: 760px) {
    .partner-card {
      grid-template-columns: 1fr;
      padding: 28px;
    }
    .partner-logo {
      width: 120px;
      height: 120px;
    }
  }

  .contact-cta {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 16px;
    padding: 40px;
  }
  .cc-photo {
    width: 220px;
    height: 220px;
    border-radius: 14px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .cc-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cc-lede {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 20px;
    max-width: 560px;
  }
  .cc-contact {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 28px;
  }
  .cc-name {
    font-family: var(--disp);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.01em;
  }
  .cc-role {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .cc-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 560px;
  }
  .cc-form .cf-submit {
    align-self: flex-start;
  }

  @media (max-width: 760px) {
    .contact-cta {
      grid-template-columns: 1fr;
      padding: 28px;
    }
    .cc-photo {
      width: 120px;
      height: 120px;
    }
  }
</style>
