---
import { getCollection } from 'astro:content';
import SpeakerCard from './SpeakerCard.astro';
import { featuredFirst } from '../utils/featured';
import { currentEdition } from '../utils/edition';
import EarlyBirdNote from './EarlyBirdNote.astro';
import { TICKET_URL, TICKET_IS_EXTERNAL } from '../config';

const ticketTarget = TICKET_IS_EXTERNAL ? '_blank' : undefined;
const ticketRel = TICKET_IS_EXTERNAL ? 'noopener noreferrer' : undefined;

// Homepage shows up to six speakers — featured first, then by `order` to fill.
// The full lineup (with keynotes pulled to the top) lives at /voices.
const all = currentEdition(await getCollection('speakers')).sort(
  (a, b) => a.data.order - b.data.order
);
const speakers = featuredFirst(all, 6);
---

<section id="voices" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="rv">The voices.</h2>
      <span class="sec-num">05 — Speakers</span>
    </div>
    <div class="voices home-voices">
      {speakers.map((s) => <SpeakerCard speaker={s} />)}
    </div>
    <div style="margin-top:30px;display:flex;gap:12px;align-items:center;flex-wrap:wrap">
      <a href="/voices" class="btn ghost">See the full lineup →</a><span class="mono" style="color:var(--ink-2)"
        >+ 36 more being announced</span
      >
    </div>
    <div class="sec-cta rv">
      <a href={TICKET_URL} class="btn" target={ticketTarget} rel={ticketRel}><span class="dot"></span>Get tickets →</a>
      <EarlyBirdNote />
    </div>
  </div>
</section>

<style>
  /* Six on the homepage sit as two rows of three; the shared `.voices` grid is
     four across, which would leave a two-card orphan on the second row. */
  @media (min-width: 861px) {
    .home-voices {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
