<section id="audience" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="rv">Who humAIn is for.</h2>
      <span class="sec-num">02 — The room</span>
    </div>
    <div class="aud">
      <div class="a rv" style="--ac:var(--pink)">
        <div class="ico">M</div>
        <h3>CMOs &amp; marketing leaders</h3>
        <p>
          Using AI in brand &amp; growth — navigating content velocity, AI search and what earns trust when machines
          mediate discovery.
        </p>
        <div class="ft">In-house · Brand · Growth</div>
      </div>
      <div class="a rv" style="--ac:var(--blue)">
        <div class="ico">F</div>
        <h3>Founders &amp; builders</h3>
        <p>
          Building AI products &amp; startups who want the cultural context and the hard questions, not just the next
          changelog.
        </p>
        <div class="ft">Startups · Product · Engineering</div>
      </div>
      <div class="a rv" style="--ac:var(--orange)">
        <div class="ico">R</div>
        <h3>Researchers</h3>
        <p>
          Exploring AI &amp; culture — operators and thinkers who need judgment and perspective more than another hype
          cycle.
        </p>
        <div class="ft">Research · Academia · Policy</div>
      </div>
      <div class="a rv" style="--ac:var(--green)">
        <div class="ico">C</div>
        <h3>Creative directors &amp; strategists</h3>
        <p>
          Working with generative AI — designers, directors and strategists navigating craft and authorship when
          generation is effectively free.
        </p>
        <div class="ft">Studios · Agencies · Independents</div>
      </div>
    </div>

    <div class="aud-stats rv">
      <div class="aud-stat-label">Past delegates</div>
